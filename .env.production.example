# maSquare — production environment variables (Railway service → Variables).
# Copy the KEYS into Railway; fill real values there. Do NOT commit real secrets.

# --- Core ---
NODE_ENV=production
# Railway injects PORT automatically; the app honours it. Leave API_PORT unset in prod.

# Postgres — on Railway, reference the managed DB: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/masquare?schema=public

# --- Security (REQUIRED in production) ---
# Base64 32-byte key. If you migrate existing data, this MUST equal your LOCAL value,
# or Amazon integration secrets stored in the DB won't decrypt.
SECRETS_MASTER_KEY=
# JWT signing secret (any long random string). Generate one just for prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Optional; defaults are fine if omitted.
# JWT_EXPIRES_IN=7d

# --- CORS ---
# Same-origin deploy (API serves the SPA) => set to your public domain.
CORS_ORIGINS=https://your-app.up.railway.app

# --- Object storage (Cloudflare R2, S3-compatible) ---
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_BUCKET=masquare-media
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public base URL for serving uploaded media (R2 public bucket or custom domain).
STORAGE_PUBLIC_URL=https://media.your-domain.com
