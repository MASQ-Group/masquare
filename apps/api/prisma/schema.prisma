// maSquare — Module 1 (Foundation) data model.
// Conventions (Module 1 §7): UUID keys; audit columns created_at/updated_at/
// created_by/updated_by; soft-delete via deleted_at. created_by/updated_by hold the
// acting user's id (kept as plain UUIDs, not relations, to avoid a tangle of User
// back-relations). Link tables carry timestamps + soft-delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------
model Company {
  id                 String   @id @default(uuid()) @db.Uuid
  officialName       String   @map("official_name")
  registrationNumber String?  @map("registration_number")
  addressLine1       String?  @map("address_line1")
  addressLine2       String?  @map("address_line2")
  addressCity        String?  @map("address_city")
  addressRegion      String?  @map("address_region")
  addressPostalCode  String?  @map("address_postal_code")
  addressCountry     String?  @map("address_country")
  email              String?
  website            String?
  phoneLandline      String?  @map("phone_landline")
  phoneMobile        String?  @map("phone_mobile")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")


  /// What this company's Amazon integrations may be used for.
  ///
  /// 'full'   — everything: orders, listings, repricing, the marketplace sweep.
  /// 'orders' — order ingestion ONLY. The company's integrations are invisible to repricing,
  ///            listing creation, fee/floor lookups and the sweep — not disabled, unreachable.
  ///
  /// Deliberately has no API and no UI. Two Amazon seller accounts must never have work performed
  /// against the wrong one, and a checkbox someone can tick by accident is not a safeguard. Changing
  /// this is a migration, which is the point.
  amazonScope String @default("full") @map("amazon_scope")

  vatRegistrations  CompanyVatRegistration[]
  contactPersons    CompanyContactPerson[]
  companyModules    CompanyModule[]
  moduleSharings    ModuleSharing[]
  userCompanyAccess UserCompanyAccess[]
  productCompanies  ProductCompany[]
  salesTransactions SalesTransaction[]
  purchaseOrders    PurchaseOrder[]
  expenses          Expense[]
  warehouses        Warehouse[]
  fbaShipments      FbaShipment[]
  channelListings   ChannelListing[]
  goodsReceipts     GoodsReceipt[]
  vendorReturns     VendorReturn[]
  salesChannels     SalesChannel[]

  @@map("company")
}

model CompanyVatRegistration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  country   String
  vatNumber String @map("vat_number")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_vat_registration")
}

model CompanyContactPerson {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  surname   String?
  email     String?
  phone     String?
  role      String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_contact_person")
}

// ---------------------------------------------------------------------------
// Modules catalogue, enablement & sharing
// ---------------------------------------------------------------------------
model Module {
  id        String  @id @default(uuid()) @db.Uuid
  key       String  @unique
  name      String
  status    String? // e.g. "core", "module-2", "future"
  isCore    Boolean @default(false) @map("is_core")
  shareable Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyModules   CompanyModule[]
  moduleSharings   ModuleSharing[]
  userModuleAccess UserModuleAccess[]

  @@map("module")
}

model CompanyModule {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  moduleId  String  @map("module_id") @db.Uuid
  enabled   Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_module")
}

model ModuleSharing {
  id        String @id @default(uuid()) @db.Uuid
  moduleId  String @map("module_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([moduleId, companyId])
  @@map("module_sharing")
}

// ---------------------------------------------------------------------------
// Users & access grants
// ---------------------------------------------------------------------------
model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  isAdmin      Boolean    @default(false) @map("is_admin")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  companyAccess UserCompanyAccess[]
  moduleAccess  UserModuleAccess[]

  @@map("user")
}

model UserCompanyAccess {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_company_access")
}

model UserModuleAccess {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  moduleId String @map("module_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}

// product_company (Module 3) — the co-ownership link for shared Products — is defined
// with the Product entity in Module 3. Named in M1 §3 for completeness; not created yet.

// ===========================================================================
// Module 2 — Global Settings: platform-global product reference data.
// (Note: the M2 spec's ERD labels the attribute library "product_attribute";
//  we name it `attribute`/`attribute_value` here so it doesn't collide with the
//  M3 product↔attribute assignment join, which is the real `product_attribute`.)
// ===========================================================================

enum ContactType {
  person
  department
}

enum AttributeInputType {
  predefined
  free_text
}

enum MeasurementSystem {
  metric
  imperial
}

enum DateFormat {
  ddmmyyyy // dd/mm/yyyy (default)
  mmddyyyy // mm/dd/yyyy
  yyyymmdd // yyyy-mm-dd
}

/// A saved column mapping for one vendor's price file, so the same layout is not re-mapped
/// every month. Matched on the vendor, then re-resolved against the uploaded file by HEADER
/// NAME first: vendors add and reorder columns between editions, and a position saved last
/// month can quietly point at a different column this month.
model VendorImportProfile {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid
  /// What the user calls this layout, e.g. "Monthly stock & price list".
  name     String
  /// Sheet this mapping applies to, when the workbook has more than one.
  sheetName String? @map("sheet_name")
  /// field -> { header, letter, ordinal }. Header is the primary key on re-resolve; letter and
  /// ordinal are kept so a headerless column can still be found, and so the UI can explain
  /// where a mapping came from.
  mapping  Json
  /// Currency the file's prices are in. Defaults from the vendor but is confirmed per upload —
  /// a price list read in the wrong currency changes every cost silently.
  currency String @default("EUR")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_import_profile")
}

/// An explicit "this vendor's code means this product" decision, for the rows their file cannot
/// match on its own. Vendor codes mostly equal our main SKU, so this is for the exceptions —
/// recorded once by a human and reused on every later upload rather than re-guessed.
model VendorSkuAlias {
  id        String @id @default(uuid()) @db.Uuid
  vendorId  String @map("vendor_id") @db.Uuid
  /// The code as it appears in the vendor's file, stored lowercased and trimmed for matching.
  vendorSku String @map("vendor_sku")
  productId String @map("product_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, vendorSku])
  @@index([productId])
  @@map("vendor_sku_alias")
}

/// One application of a vendor price file. Holds enough to undo itself: a bulk cost change is
/// invisible in a P&L until someone notices the margin, so every run is reversible by design.
model VendorImportRun {
  id        String  @id @default(uuid()) @db.Uuid
  vendorId  String  @map("vendor_id") @db.Uuid
  profileId String? @map("profile_id") @db.Uuid
  fileName  String  @map("file_name")
  sheetName String? @map("sheet_name")
  /// Currency the file's prices were read in — confirmed by a human at upload.
  currency  String  @default("EUR")

  /// Extra off-invoice discounts applied at upload, keyed by OUR brand id. Recorded so a run's
  /// costs can be explained later without the original file.
  brandDiscounts Json? @map("brand_discounts")

  rowsTotal   Int @default(0) @map("rows_total")
  rowsMatched Int @default(0) @map("rows_matched")
  changed     Int @default(0)

  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by") @db.Uuid
  rolledBackAt DateTime? @map("rolled_back_at")
  rolledBackById String? @map("rolled_back_by") @db.Uuid

  vendor  Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  changes VendorImportChange[]

  @@index([vendorId])
  @@map("vendor_import_run")
}

/// One field on one product, with the value it had before. The "before" is what makes a run
/// reversible; it is captured at apply time, not read back later.
model VendorImportChange {
  id        String @id @default(uuid()) @db.Uuid
  runId     String @map("run_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  /// purchaseCost | map | availability | ean | upc
  field     String
  oldValue  String? @map("old_value")
  newValue  String? @map("new_value")
  /// Set when the change was reverted, so a partial rollback is still auditable.
  revertedAt DateTime? @map("reverted_at")

  run     VendorImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([productId])
  @@map("vendor_import_change")
}

model Vendor {
  id                String  @id @default(uuid()) @db.Uuid
  name              String
  vatNumber         String? @map("vat_number")
  addressLine1      String? @map("address_line1")
  addressLine2      String? @map("address_line2")
  addressCity       String? @map("address_city")
  addressRegion     String? @map("address_region")
  addressPostalCode String? @map("address_postal_code")
  addressCountry    String? @map("address_country")
  phone             String?
  email             String?
  website           String?

  // How VAT is treated on purchase orders to this vendor. Set by the user; the UI
  // suggests a value from the vendor's country and its VIES check.
  //   standard      — charge VAT at each item's VAT class rate (local/Cyprus)
  //   reverse_charge — EU B2B supply, 0% with the Art. 196 note on the PDF
  //   outside_scope  — supplier outside the EU VAT zone, 0%
  vatTreatment String @default("standard") @map("vat_treatment")
  /** Currency this vendor invoices in. New POs default to it, as do uploaded price files. */
  currency String @default("EUR")
  // Whether the MAP / suggested retail price this vendor quotes already contains VAT.
  // Vendors are not consistent: one price list heads the column "SRP (INC)" and another
  // "DP (EXL)" beside it. Getting it wrong shifts every MAP by the VAT rate, so it is stated
  // per vendor rather than guessed from the file.
  mapIncludesVat Boolean @default(false) @map("map_includes_vat")
  // Result of the last VIES lookup. Advisory only — never blocks raising a PO.
  vatNumberValid     Boolean?  @map("vat_number_valid")
  vatNumberCheckedAt DateTime? @map("vat_number_checked_at")
  vatNumberCheckedName String? @map("vat_number_checked_name")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  contacts VendorContact[]
  products Product[]
  importProfiles VendorImportProfile[]
  skuAliases     VendorSkuAlias[]
  importRuns     VendorImportRun[]
  purchaseOrders PurchaseOrder[]
  vendorReturns  VendorReturn[]

  @@map("vendor")
}

model VendorContact {
  id           String       @id @default(uuid()) @db.Uuid
  vendorId     String       @map("vendor_id") @db.Uuid
  contactName  String?      @map("contact_name")
  contactPhone String?      @map("contact_phone")
  contactEmail String?      @map("contact_email")
  contactType  ContactType? @map("contact_type")
  contactRole  String?      @map("contact_role")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_contact")
}

model Brand {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  website String?

  // GPSR contacts (EU 2023/988, in force 13 Dec 2024). Held here rather than on the product
  // because they describe a company: Fissler's responsible person is the same on every Fissler
  // line. Products inherit these; nothing blocks on them being empty.
  manufacturerName       String? @map("manufacturer_name")
  manufacturerAddress    String? @map("manufacturer_address")
  manufacturerEmail      String? @map("manufacturer_email")
  manufacturerPhone      String? @map("manufacturer_phone")
  manufacturerContactUrl String? @map("manufacturer_contact_url")
  /** Required when the manufacturer sits outside the EU. */
  euRpName               String? @map("eu_rp_name")
  euRpAddress            String? @map("eu_rp_address")
  euRpEmail              String? @map("eu_rp_email")
  euRpPhone              String? @map("eu_rp_phone")
  euRpContactUrl         String? @map("eu_rp_contact_url")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("brand")
}

// Top-level product classification (Equipment / Service). Broader than ProductType, and
// editable reference data. Equipment vs Service governs whether a product physically ships.
model ProductClass {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("product_class")
}

model ProductType {
  id   String @id @default(uuid()) @db.Uuid
  name String

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("product_type")
}

model FulfilmentType {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  code   String?
  active Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]
  aliases  ProductSkuAlias[]

  @@map("fulfilment_type")
}

// Cyprus VAT classes. Assigned to a product and, from the local-sales phase on,
// snapshotted onto each sales line so a later rate change never rewrites history.
// taxTreatment keeps zero-rated and exempt distinguishable in reports: both charge
// 0% but they are not the same thing for a VAT return.
model VatClass {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  ratePct      Decimal @map("rate_pct") @db.Decimal(5, 2)
  taxTreatment String  @map("tax_treatment") // standard | reduced | zero | exempt
  sortOrder    Int     @default(0) @map("sort_order")
  isDefault    Boolean @default(false) @map("is_default")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products              Product[]
  salesTransactionItems SalesTransactionItem[]
  purchaseOrderLines    PurchaseOrderLine[]

  @@map("vat_class")
}

model ProductCategory {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  parentId  String? @map("parent_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_category")
}

model Attribute {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  inputType AttributeInputType @map("input_type")
  // When true, a single product/SKU may carry this attribute more than once (e.g. multiple
  // "Compatible With" or "Material" values). When false (default) the product editor offers
  // the attribute only once per SKU.
  allowMultiple Boolean @default(false) @map("allow_multiple")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  values            AttributeValue[]
  productAttributes ProductAttribute[]

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@map("attribute_value")
}

// Singleton row holding platform-wide format defaults (§9).
model PlatformSettings {
  /// Whether creating real marketplace listings is permitted. Off by default; LISTING_LIVE_WRITES
  /// can force it off regardless, and every submission is separately confirmed by a human.
  listingLiveWrites Boolean @default(false) @map("listing_live_writes")

  /// Margin a new listing launches at, as a percentage. Separate from the repricing floor margin
  /// on purpose: listing at the floor only makes sense once the repricer is live to raise it.
  launchMarginPct Decimal @default(20) @map("launch_margin_pct") @db.Decimal(5, 2)
  id                String            @id @default(uuid()) @db.Uuid
  measurementSystem MeasurementSystem @default(metric) @map("measurement_system")
  dateFormat        DateFormat        @default(ddmmyyyy) @map("date_format")
  // Admin-defined standard column set for the Sales Transactions list (JSON array of keys).
  salesTxStandardColumns String? @map("sales_tx_standard_columns")
  // Platform typography — the primary/body font and the monospace/code font.
  // Values are font-family keys resolved against the web font registry.
  bodyFont String @default("Inter") @map("body_font")
  monoFont String @default("JetBrains Mono") @map("mono_font")

  // Whether submitting a sale takes the goods off the shelf.
  //
  // Off by default and deliberately so: deduction is only meaningful once opening stock
  // has been counted in. Switched on against an empty catalogue, every sale would ship
  // short and the stock-owed register would be noise rather than signal.
  //
  // Forward-only by construction — deduction happens when a transaction is submitted, so
  // sales submitted before this was switched on are never retrospectively deducted. That
  // matters because opening stock is a physical count that already reflects past sales.
  deductStockOnSale Boolean @default(false) @map("deduct_stock_on_sale")

  // The most OnBuy boost any listing may carry. OnBuy defaults new offers to 20%; we default to 0
  // and refuse anything above this rather than warn, because a warning on a bulk action is read
  // once and the commission is paid every month afterwards.
  maxBoostPct Decimal @default(0) @map("max_boost_pct") @db.Decimal(5, 2)

  // Whether a channel sync applies cancellations & refunds it pulls (marking the matched
  // transaction cancelled/refunded, releasing stock, flagging the return decision). Off by
  // default so the behaviour stays dormant on an environment until it's deliberately enabled —
  // demo and live run the same code, so this is the switch that keeps it off live until review.
  applyChannelResolutions Boolean @default(false) @map("apply_channel_resolutions")

  // Whether a submitted sale lowers channel Availability (the sellable number broadcast to
  // channels) and schedules a push of the new figure to every channel the SKU is listed on.
  // Off by default: turning it on starts making live quantity writes to the marketplaces, so
  // it stays dormant until deliberately enabled. Forward-only, like deductStockOnSale.
  autoAdjustAvailabilityOnSale Boolean @default(false) @map("auto_adjust_availability_on_sale")

  // Time of day the daily channel auto-sync runs, as "HH:MM" (24h, server time = UTC). Drives a
  // dynamically-scheduled cron (integrations.service) — editable from the Integrations page.
  channelSyncTime String @default("05:00") @map("channel_sync_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ===========================================================================
// Module 3 — Products: master record, aliases, media, attribute assignments,
// and the co-ownership link to companies (product_company, named in M1 §3).
// Money is stored as amount (Decimal) + currency_code (default EUR).
// Volumetric weight is NOT stored — it's derived on read from dimensions.
// ===========================================================================

model Product {
  id    String @id @default(uuid()) @db.Uuid
  mainSku String @unique @map("main_sku")
  title String

  brandId          String? @map("brand_id") @db.Uuid
  vendorId         String? @map("vendor_id") @db.Uuid
  productClassId   String? @map("product_class_id") @db.Uuid
  productTypeId    String? @map("product_type_id") @db.Uuid
  fulfilmentTypeId String? @map("fulfilment_type_id") @db.Uuid
  categoryId       String? @map("category_id") @db.Uuid
  vatClassId       String? @map("vat_class_id") @db.Uuid

  // Identifiers & origin
  ean             String?
  upc             String?
  vendorSku       String? @map("vendor_sku")
  manufacturerSku String? @map("manufacturer_sku")
  countryOfOrigin String? @map("country_of_origin")
  hsCode          String? @map("hs_code")

  // Cost & pricing (amount + currency)
  /**
   * Individual units of this product are tracked by serial number.
   *
   * Opt-in: only products where it matters carry the receiving and dispatch burden.
   * Once on, a goods receipt must name a serial for every unit, and a sales transaction
   * cannot be submitted without naming which serials leave.
   */
  serialTracked        Boolean   @default(false) @map("serial_tracked")

  /**
   * Moving weighted average cost per unit, in EUR, at landed cost. Maintained by the
   * costing engine when a goods receipt posts — never edited by hand. Null until the
   * product has been costed at least once. The ledger in ProductCostEvent explains it.
   */
  averageCostEur       Decimal?  @map("average_cost_eur") @db.Decimal(14, 4)
  averageCostQty       Int       @default(0) @map("average_cost_qty")
  averageCostUpdatedAt DateTime? @map("average_cost_updated_at")

  purchaseCostAmount   Decimal? @map("purchase_cost_amount") @db.Decimal(14, 4)
  purchaseCostCurrency String   @default("EUR") @map("purchase_cost_currency")
  mapAmount            Decimal? @map("map_amount") @db.Decimal(14, 4)
  mapCurrency          String   @default("EUR") @map("map_currency")
  msrpAmount           Decimal? @map("msrp_amount") @db.Decimal(14, 4)
  msrpCurrency         String   @default("EUR") @map("msrp_currency")

  // ---- Listing content ----------------------------------------------------
  // Only eBay and Shopify ever display any of this. Amazon and OnBuy attach our offer to their own
  // catalogue entry and show their own copy, so `title` above stays what it has always been: a name
  // for our own people, not a marketplace field.
  /** eBay's title, capped at 80 characters by eBay itself. Written for search, not for us. */
  ebayTitle       String? @map("ebay_title")
  descriptionHtml String? @map("description_html")
  /** Ordered selling points. Rendered as bullets by every channel that takes them. */
  keyFeatures     String[] @map("key_features")
  searchKeywords  String? @map("search_keywords")

  // ---- Technical facts (drive channel eligibility) ------------------------
  // Chosen from a controlled vocabulary, never typed. A rule cannot reliably read "220-240V ~50Hz"
  // out of free text, and a compliance answer that varies by who typed it is not an answer. Every
  // one is nullable — "not stated" has to stay distinguishable from "stated as none".
  voltageRatingId String? @map("voltage_rating_id") @db.Uuid
  frequencyId     String? @map("frequency_id") @db.Uuid
  plugTypeId      String? @map("plug_type_id") @db.Uuid
  batteryRequired Boolean? @map("battery_required")
  batteryTypeId   String? @map("battery_type_id") @db.Uuid
  hazmatClassId   String? @map("hazmat_class_id") @db.Uuid

  // ---- Product-level compliance -------------------------------------------
  // Manufacturer and EU responsible person live on Brand — they are facts about a company, not a
  // product, and retyping an address onto thousands of rows is how that data goes wrong. What
  // genuinely varies per product sits here.
  warrantyText       String? @map("warranty_text")
  dangerousGoodsNote String? @map("dangerous_goods_note")

  // Package & logistics (metric base units: kg, cm)
  productWeightKg Decimal? @map("product_weight_kg") @db.Decimal(10, 3)
  packageWeightKg Decimal? @map("package_weight_kg") @db.Decimal(10, 3)
  packageLengthCm Decimal? @map("package_length_cm") @db.Decimal(10, 2)
  packageWidthCm  Decimal? @map("package_width_cm") @db.Decimal(10, 2)
  packageHeightCm Decimal? @map("package_height_cm") @db.Decimal(10, 2)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  productClass  ProductClass?   @relation(fields: [productClassId], references: [id], onDelete: SetNull)
  productType   ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  fulfilmentType FulfilmentType? @relation(fields: [fulfilmentTypeId], references: [id], onDelete: SetNull)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vatClass      VatClass?       @relation(fields: [vatClassId], references: [id], onDelete: SetNull)

  aliases              ProductSkuAlias[]
  media                ProductMedia[]
  attributes           ProductAttribute[]
  companies            ProductCompany[]
  salesTransactionItems SalesTransactionItem[]
  fbaShipmentItems     FbaShipmentItem[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]
  costEvents           ProductCostEvent[]
  serialNumbers        SerialNumber[]
  vendorReturnLines    VendorReturnLine[]
  stockOwed            StockOwed[]
  availability         ProductAvailability?
  vendorSkuAliases     VendorSkuAlias[]
  vendorImportChanges  VendorImportChange[]
  availabilityLedger   AvailabilityLedger[]
  channelListings      ChannelListing[]

  voltageRating ComplianceOption? @relation("ProductVoltageRating", fields: [voltageRatingId], references: [id], onDelete: SetNull)
  frequency     ComplianceOption? @relation("ProductFrequency", fields: [frequencyId], references: [id], onDelete: SetNull)
  plugTypeRef   ComplianceOption? @relation("ProductPlugType", fields: [plugTypeId], references: [id], onDelete: SetNull)
  batteryTypeRef ComplianceOption? @relation("ProductBatteryType", fields: [batteryTypeId], references: [id], onDelete: SetNull)
  hazmatClassRef ComplianceOption? @relation("ProductHazmatClass", fields: [hazmatClassId], references: [id], onDelete: SetNull)
  channelPlans         ProductChannelPlan[]

  // Every products list filters out soft-deleted rows and often filters by one of
  // these FKs (brand/vendor/type/category); none were indexed before.
  @@index([deletedAt])
  @@index([brandId])
  @@index([vendorId])
  @@index([categoryId])
  @@index([productTypeId])
  @@index([fulfilmentTypeId])
  @@map("product")
}

// ===========================================================================
// Channel availability — the sellable quantity broadcast to sales channels.
// SEPARATE from warehouse StockLevel: this is the arbitrage/vendor-backed number
// that every connected channel (Amazon, OnBuy, eBay) is kept in sync with.
// ===========================================================================

model ProductAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @unique @map("product_id") @db.Uuid
  quantity    Int      @default(0)
  // What last set the quantity: manual | vendor_import | sale | return.
  lastSource  String?  @map("last_source")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_availability")
}

/// Every change to a product's availability, for traceability.
model AvailabilityLedger {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  delta       Int
  newQuantity Int      @map("new_quantity")
  // manual_set | manual_adjust | sale | cancellation | return | vendor_import
  reason      String
  refType     String?  @map("ref_type") // e.g. 'sales_transaction'
  refId       String?  @map("ref_id") @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("availability_ledger")
}

/// A product's current listing on one channel integration (marketplace) — populated by
/// pulling from the channel; drives the listings dashboard and drift detection.
model ChannelListing {
  id               String    @id @default(uuid()) @db.Uuid
  // Owning company. Listings are per-company (separate channel accounts).
  companyId        String?   @map("company_id") @db.Uuid
  integrationId    String    @map("integration_id") @db.Uuid
  channelSku       String    @map("channel_sku")
  // Marketplace this listing belongs to, as an ISO-2 country code (e.g. GB, US, DE). eBay uses
  // ONE integration/token across many marketplaces, so this splits its listings into per-market
  // columns. Empty string for single-marketplace integrations (Amazon, OnBuy).
  marketplace      String    @default("")
  productId        String?   @map("product_id") @db.Uuid // null = unmatched to our catalogue
  asin             String?
  // The marketplace's OWN identifier for this listing/product: eBay ItemID, Amazon ASIN, OnBuy
  // OPC. eBay needs the ItemID to revise quantity (classic listings reject the SKU as an
  // identifier), and we surface all of them on the product card. Nullable — not every pull has one.
  externalListingId String?  @map("external_listing_id")
  title            String?
  listedQuantity   Int?      @map("listed_quantity")
  listedPrice      Float?    @map("listed_price")
  currency         String?
  fulfilmentChannel String?  @map("fulfilment_channel") // FBM | FBA
  listingStatus    String?   @map("listing_status")
  lastPulledAt     DateTime? @map("last_pulled_at")
  lastPushedAt     DateTime? @map("last_pushed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([integrationId, channelSku, marketplace])
  @@index([productId])
  @@index([companyId])
  @@map("channel_listing")
}

/// What a marketplace's mains supply and plug standard actually are.
///
/// Reference data, not rules-as-code: a 230V appliance must never reach a US listing however
/// complete its record is, and that verdict has to be reachable by someone editing a table rather
/// than by a deploy. Compared against the product's own typed voltage/plug fields.
/**
 * Controlled vocabularies for the facts a marketplace judges a product on.
 *
 * One table rather than five, because the shape is identical and the alternative is five near-copies
 * of the same CRUD. `kind` names the list; `code` is what the rules and the channels see; `label` is
 * what a person reads. Editable, so a value nobody anticipated does not need a deploy.
 */
model ComplianceOption {
  id    String @id @default(uuid()) @db.Uuid
  /** VOLTAGE_RATING | FREQUENCY | PLUG_TYPE | BATTERY_TYPE | HAZMAT_CLASS */
  kind  String
  code  String
  label String

  /**
   * The mains range a voltage rating stands for, in volts.
   *
   * Only VOLTAGE_RATING uses these, and it is why the vocabulary exists: the eligibility rules
   * compare numbers, so the range has to travel with the option rather than be parsed out of its
   * label. Null on every other kind, and on ratings that are not mains-powered at all.
   */
  numericMin Int? @map("numeric_min")
  numericMax Int? @map("numeric_max")

  note      String?
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  productsVoltage     Product[] @relation("ProductVoltageRating")
  productsFrequency   Product[] @relation("ProductFrequency")
  productsPlugType    Product[] @relation("ProductPlugType")
  productsBatteryType Product[] @relation("ProductBatteryType")
  productsHazmatClass Product[] @relation("ProductHazmatClass")

  @@unique([kind, code])
  @@index([kind, active])
  @@map("compliance_option")
}

model MarketplaceProfile {
  id          String @id @default(uuid()) @db.Uuid
  /// amazon | ebay | onbuy | shopify
  channelType String @map("channel_type")
  /// ISO-2 country of the marketplace. Empty string = every marketplace of this channel type.
  marketplace String @default("")
  label       String

  mainsVoltageMinV Int?     @map("mains_voltage_min_v")
  mainsVoltageMaxV Int?     @map("mains_voltage_max_v")
  mainsFrequencyHz String?  @map("mains_frequency_hz")
  /// IEC plug letters accepted in this market, e.g. ["G"] for the UK.
  plugTypes        String[] @map("plug_types")
  allowBatteries   Boolean  @default(true) @map("allow_batteries")
  allowHazmat      Boolean  @default(true) @map("allow_hazmat")

  /// Off switches the profile off without deleting it.
  active Boolean @default(true)
  note   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([channelType, marketplace])
  @@map("marketplace_profile")
}

/// Our intention to list one product on one channel — everything the channel needs that the
/// product record itself does not carry.
///
/// Created on demand, never seeded: four thousand products across twenty channels would be eighty
/// thousand empty rows, and a row existing means someone has started preparing a listing.
/// Eligibility is NOT stored here; it is derived from the product and the marketplace profile, so
/// correcting a voltage fixes every verdict at once instead of leaving stale ones behind.
model ProductChannelPlan {
  id            String @id @default(uuid()) @db.Uuid
  productId     String @map("product_id") @db.Uuid
  integrationId String @map("integration_id") @db.Uuid
  /// ISO-2 for channels that span markets on one token (eBay); empty otherwise.
  marketplace   String @default("")

  /// The channel's own category handle: Amazon productType, eBay categoryId, OnBuy category.
  categoryRef  String? @map("category_ref")
  categoryName String? @map("category_name")
  /// Category-specific values, keyed by the channel's own aspect names. JSON because the required
  /// set differs per category and is discovered from the channel at runtime, never hard-coded.
  aspects      Json?

  /// NEW everywhere except eBay, which occasionally sells open box or used.
  condition        String  @default("NEW")
  handlingTimeDays Int?    @map("handling_time_days")
  /// What this offer launches at, in the marketplace's own currency, in minor units. Per
  /// marketplace rather than per product: a different currency, different competitors, different
  /// fees. Null means nobody has decided yet — which is not the same as free.
  offerPriceCents  Int?    @map("offer_price_cents")
  /// OnBuy delivery template key.
  deliveryTemplate String? @map("delivery_template")
  /// OnBuy boost. Zero unless a human decides otherwise — OnBuy's own default is 20%, a fifth of
  /// revenue, so it is never inherited from them and never set by automation.
  boostPct         Decimal @default(0) @map("boost_pct") @db.Decimal(5, 2)

  /// DRAFT | READY | LISTED | ARCHIVED. A human moves it to LISTED; nothing publishes itself.
  status String @default("DRAFT")
  /// Set once the channel confirms the listing: ASIN, eBay ItemID, OnBuy OPC.
  externalListingId String?   @map("external_listing_id")
  listedAt          DateTime? @map("listed_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([productId, integrationId, marketplace])
  @@index([integrationId, status])
  @@index([deletedAt])
  @@map("product_channel_plan")
}

/// Audit of every quantity/price push to a channel listing (one row per listing per attempt),
/// including dry-runs. Lets us show push health and debug failures. integrationId is a plain
/// field (no relation) so audit rows survive independently.
model ChannelPush {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  integrationId  String   @map("integration_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  channelSku     String   @map("channel_sku")
  marketplace    String   @default("")
  field          String   // 'quantity' (price/listing later)
  requestedValue Int?     @map("requested_value")
  previousValue  Int?     @map("previous_value")
  ok             Boolean
  message        String?
  dryRun         Boolean  @default(false) @map("dry_run")
  createdAt      DateTime @default(now()) @map("created_at")
  createdById    String?  @map("created_by") @db.Uuid

  @@index([productId])
  @@index([integrationId])
  @@index([createdAt])
  @@map("channel_push")
}

// ===========================================================================
// Inventory (Module: Warehouses). Stock is held per (product, warehouse).
// Company-wide availability = the sum across warehouses that are active AND
// flagged include_in_inventory — so "Damaged", "Quarantine" or "In Transit"
// hold visible stock without ever counting as sellable.
// ===========================================================================
model Warehouse {
  id   String @id @default(uuid()) @db.Uuid
  // Owning company. Warehouses (and all stock held in them) are company-isolated.
  companyId String? @map("company_id") @db.Uuid
  name String
  type String @default("physical") // physical | virtual
  // Warehouses form a tree (e.g. Main Store → FBA Reserved / Damaged Goods).
  // Arbitrary depth; cycles are rejected in the service.
  parentWarehouseId String? @map("parent_warehouse_id") @db.Uuid
  // Does stock here count toward company-wide availability / "in stock"?
  includeInInventory Boolean @default(true) @map("include_in_inventory")
  // Deactivated rather than deleted once movements reference it.
  isActive Boolean @default(true) @map("is_active")
  notes    String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  company  Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  parent   Warehouse?  @relation("WarehouseTree", fields: [parentWarehouseId], references: [id], onDelete: SetNull)
  children Warehouse[] @relation("WarehouseTree")

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  vendorReturns  VendorReturn[]
  serialNumbers  SerialNumber[]
  stockOwed      StockOwed[]

  @@index([parentWarehouseId])
  @@index([companyId])
  @@map("warehouse")
}

/** Current quantity of a product in one warehouse. One row per (product, warehouse). */
model StockLevel {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @map("product_id") @db.Uuid
  warehouseId    String @map("warehouse_id") @db.Uuid
  quantityOnHand Int    @default(0) @map("quantity_on_hand")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_level")
}

/** Append-only audit of every stock change. Nothing may alter a StockLevel without
 *  writing one of these, so a balance can always be explained. */
model StockMovement {
  id           String @id @default(uuid()) @db.Uuid
  productId    String @map("product_id") @db.Uuid
  warehouseId  String @map("warehouse_id") @db.Uuid
  qtyDelta     Int    @map("qty_delta") // signed: +in, -out
  balanceAfter Int    @map("balance_after") // the warehouse balance once this was applied
  // opening_balance | adjustment | damage | stocktake | transfer | goods_receipt | sale
  reason    String
  reference String? // free-text doc reference (PO/receipt/order)
  notes     String?

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movement")
}

// ===========================================================================
// Purchase Orders. Issued by one of our companies to an existing vendor.
// Lifecycle: draft → submitted → partially_received → received, or → cancelled.
// draft is fully editable; once submitted, lines lock and quantity_received is
// driven only by posted Goods Receipts (built in the receiving phase) — never by
// hand. quantityReceived stays 0 until then.
// ===========================================================================
model PurchaseOrder {
  id       String @id @default(uuid()) @db.Uuid
  poNumber String @unique @map("po_number") // PO-YYYY-NNNNN, year-scoped sequence
  // Issuing legal entity — drives the letterhead on the branded PDF.
  companyId String @map("company_id") @db.Uuid
  vendorId  String @map("vendor_id") @db.Uuid
  status    String @default("draft") // draft | submitted | partially_received | received | cancelled
  currency  String @default("EUR")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  // VAT treatment snapshotted from the vendor when the order is raised, so editing
  // the vendor later never rewrites historical orders. Drives the per-line VAT below.
  vatTreatment String @default("standard") @map("vat_treatment")
  // --- FX ---------------------------------------------------------------------
  // Goods are priced in `currency` (the vendor's). Everything downstream — average
  // cost, margin — is EUR, so we need a rate to get there.
  //
  // `amountPaidEur` is what actually left the bank to settle this order. When it is
  // known it beats any market rate, because it is the rate we genuinely got. Until
  // then `fxRate` (units of `currency` per 1 EUR) is used as the working estimate.
  fxRate        Decimal? @map("fx_rate") @db.Decimal(18, 8)
  amountPaidEur Decimal? @map("amount_paid_eur") @db.Decimal(14, 2)

  // --- Ancillary costs ---------------------------------------------------------
  // Each carries its own currency because freight and duty are often invoiced in EUR
  // even when the goods are not. Shipping, duty and handling are allocated across the
  // received lines and enter average cost; import VAT is reporting-only and never does.
  shippingCost         Decimal? @map("shipping_cost") @db.Decimal(14, 2)
  shippingCurrency     String   @default("EUR") @map("shipping_currency")
  shippingAllocation   String   @default("weight") @map("shipping_allocation")
  customsDuty          Decimal? @map("customs_duty") @db.Decimal(14, 2)
  customsDutyCurrency  String   @default("EUR") @map("customs_duty_currency")
  customsDutyAllocation String  @default("value") @map("customs_duty_allocation")
  importHandling         Decimal? @map("import_handling") @db.Decimal(14, 2)
  importHandlingCurrency String   @default("EUR") @map("import_handling_currency")
  importHandlingAllocation String @default("value") @map("import_handling_allocation")
  /** Reporting only — never enters product cost. */
  importVat         Decimal? @map("import_vat") @db.Decimal(14, 2)
  importVatCurrency String   @default("EUR") @map("import_vat_currency")

  // Where received stock lands by default. Null = decide at receiving time.
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid
  notes String?

  submittedAt DateTime? @map("submitted_at")
  cancelledAt DateTime? @map("cancelled_at")
  receivedAt  DateTime? @map("received_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  company              Company    @relation(fields: [companyId], references: [id])
  vendor               Vendor     @relation(fields: [vendorId], references: [id])
  destinationWarehouse Warehouse? @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  lines         PurchaseOrderLine[]
  statusEvents   PurchaseOrderStatusEvent[]
  goodsReceipts  GoodsReceipt[]
  unlockRequests PurchaseOrderUnlockRequest[]
  vendorReturns  VendorReturn[]

  @@index([vendorId])
  @@index([companyId])
  @@index([status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantityOrdered Int     @map("quantity_ordered")
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 4)
  // VAT resolved at save time: the product's VAT class when the order charges VAT,
  // otherwise a 0% snapshot. Rate is stored so a later rate change can't rewrite history.
  vatClassId String?  @map("vat_class_id") @db.Uuid
  vatRatePct Float    @default(0) @map("vat_rate_pct")
  vatAmount  Decimal  @default(0) @map("vat_amount") @db.Decimal(14, 2)
  // Maintained from Goods Receipt lines in the receiving phase; 0 until then.
  quantityReceived Int    @default(0) @map("quantity_received")
  notes     String?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  vatClass      VatClass?     @relation(fields: [vatClassId], references: [id], onDelete: SetNull)
  receiptLines  GoodsReceiptLine[]
  vendorReturnLines VendorReturnLine[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_line")
}

// ===========================================================================
// Goods Receipts (goods-received notes) — distinct from any payment receipt.
// One pending receipt is raised automatically when a PO is submitted. Posting it
// is what puts stock on hand; a short delivery spawns a backorder receipt for the
// remainder, repeating until the PO is fully received or closed short.
// ===========================================================================
model GoodsReceipt {
  id              String @id @default(uuid()) @db.Uuid
  receiptNumber   String @unique @map("receipt_number") // GR-YYYY-NNNNN, year-scoped
  // Owning company (denormalised from the PO for uniform scoping).
  companyId       String? @map("company_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  status          String @default("pending") // pending | posted | cancelled
  // True when this receipt covers the shortfall left by an earlier one.
  isBackorder     Boolean @default(false) @map("is_backorder")
  parentReceiptId String? @map("parent_receipt_id") @db.Uuid
  // Where the stock lands. Defaults from the PO, changeable at receiving time.
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid
  // --- Landed costs actually incurred on THIS shipment ---------------------------
  // A PO can arrive in several deliveries, each with its own freight and clearance
  // invoice, so the amounts are captured per receipt rather than taken from the PO.
  // They default to this receipt's pro-rata share of the PO figures and are editable
  // at posting time. The allocation methods are snapshotted from the PO so a later
  // change to the order never rewrites what a posted receipt already costed.
  shippingCost     Decimal? @map("shipping_cost") @db.Decimal(14, 2)
  shippingCurrency String   @default("EUR") @map("shipping_currency")
  shippingAllocation String @default("weight") @map("shipping_allocation")
  customsDuty      Decimal? @map("customs_duty") @db.Decimal(14, 2)
  customsDutyCurrency String @default("EUR") @map("customs_duty_currency")
  customsDutyAllocation String @default("value") @map("customs_duty_allocation")
  importHandling   Decimal? @map("import_handling") @db.Decimal(14, 2)
  importHandlingCurrency String @default("EUR") @map("import_handling_currency")
  importHandlingAllocation String @default("value") @map("import_handling_allocation")
  /** Reporting only — never enters product cost. */
  importVat        Decimal? @map("import_vat") @db.Decimal(14, 2)
  importVatCurrency String  @default("EUR") @map("import_vat_currency")
  /** Rate used to bring this receipt's goods to EUR, snapshotted at posting. */
  fxRateUsed       Decimal? @map("fx_rate_used") @db.Decimal(18, 8)

  notes    String?
  postedAt DateTime? @map("posted_at")
  postedById String?  @map("posted_by") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  purchaseOrder        PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  destinationWarehouse Warehouse?    @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  parent     GoodsReceipt?  @relation("ReceiptBackorder", fields: [parentReceiptId], references: [id], onDelete: SetNull)
  backorders GoodsReceipt[] @relation("ReceiptBackorder")
  lines      GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([status])
  @@index([companyId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                  String @id @default(uuid()) @db.Uuid
  goodsReceiptId      String @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String @map("purchase_order_line_id") @db.Uuid
  /** Outstanding quantity on the PO line when this receipt was raised. */
  quantityExpected    Int    @map("quantity_expected")
  quantityReceived    Int    @default(0) @map("quantity_received")
  sortOrder           Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_line")
}

/**
 * One physical unit of a serial-tracked product, and where it is.
 *
 * Created when the unit is received and retired when it leaves, so the rows with
 * status `in_stock` are exactly what is on the shelf. The serial is unique per product
 * rather than globally — two vendors can legitimately use the same sequence.
 */
model SerialNumber {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  serial    String

  /** in_stock | sold | returned_to_vendor | scrapped */
  status      String  @default("in_stock")
  /** Where it sits while in stock; null once it has left. */
  warehouseId String? @map("warehouse_id") @db.Uuid

  /** How it arrived. */
  goodsReceiptId String? @map("goods_receipt_id") @db.Uuid
  receivedAt     DateTime? @map("received_at")

  /** How it left — exactly one of these is set once it is no longer in stock. */
  salesTransactionId String?   @map("sales_transaction_id") @db.Uuid
  vendorReturnId     String?   @map("vendor_return_id") @db.Uuid
  dispatchedAt       DateTime? @map("dispatched_at")

  notes String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([productId, serial])
  @@index([productId, status])
  @@index([warehouseId])
  @@index([salesTransactionId])
  @@map("serial_number")
}

/**
 * Stock sold before it was on the shelf.
 *
 * The business is dynamic: a channel deadline can force a shipment days before the vendor
 * delivers. Blocking that would cost a real sale, so the sale always goes through — but the
 * gap it leaves is recorded here rather than swallowed.
 *
 * Why this is not simply a negative quantity_on_hand:
 *  - a negative balance is not located anywhere; you cannot have -3 units in a warehouse,
 *    and a stocktake would have nothing to reconcile against;
 *  - it corrupts the moving average, which reseeds itself whenever the balance is <= 0,
 *    silently discarding the blend on the next receipt;
 *  - a bare number carries no date, cause, or owner, so nothing can chase it.
 *
 * Rows are opened when a submitted sale cannot be covered, and closed automatically when a
 * goods receipt for the same product lands (oldest first).
 */
model StockOwed {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  /** Where the goods should have left from — the shortfall belongs to that location. */
  warehouseId String? @map("warehouse_id") @db.Uuid

  /** The sale that could not be covered. */
  salesTransactionId String  @map("sales_transaction_id") @db.Uuid
  transactionRef     String? @map("transaction_ref")

  /** Units short when the sale was submitted, and how many have since been covered. */
  quantity        Int @default(0)
  quantitySettled Int @default(0) @map("quantity_settled")

  /** open | settled | cancelled */
  status String @default("open")
  /** sold_before_receipt | manual */
  reason String @default("sold_before_receipt")

  /** When this ought to be cleared — the expected delivery, so overdue items can escalate. */
  dueBy DateTime? @map("due_by")

  notes String?

  openedAt    DateTime  @default(now()) @map("opened_at")
  openedById  String?   @map("opened_by") @db.Uuid
  settledAt   DateTime? @map("settled_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  salesTransaction SalesTransaction @relation(fields: [salesTransactionId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([salesTransactionId])
  @@index([status, openedAt])
  @@map("stock_owed")
}

/**
 * Goods sent back to the vendor.
 *
 * A posted goods receipt is never rewritten, so returning stock is its own document
 * rather than an edit of history. Posting one takes the stock out at the product's
 * current average cost — which leaves the average untouched for the units that stay,
 * the correct behaviour for a moving average.
 */
model VendorReturn {
  id           String @id @default(uuid()) @db.Uuid
  returnNumber String @unique @map("return_number") // RTV-YYYY-NNNNN, year-scoped
  // Owning company (denormalised from the source warehouse/PO for uniform scoping).
  companyId    String? @map("company_id") @db.Uuid
  vendorId     String @map("vendor_id") @db.Uuid
  /** Set when the return is against a specific order; standalone returns leave it null. */
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  /** Where the stock leaves from. */
  warehouseId  String @map("warehouse_id") @db.Uuid

  status        String  @default("posted") // posted | cancelled
  reason        String
  creditNoteRef String? @map("credit_note_ref")
  notes         String?

  /** Value removed, at average cost, frozen at posting. */
  totalQuantity Int     @default(0) @map("total_quantity")
  totalCostEur  Decimal @default(0) @map("total_cost_eur") @db.Decimal(14, 2)

  postedAt    DateTime  @default(now()) @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lines         VendorReturnLine[]

  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([companyId])
  @@map("vendor_return")
}

model VendorReturnLine {
  id             String @id @default(uuid()) @db.Uuid
  vendorReturnId String @map("vendor_return_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  /** Links the return back to the ordered line so the PO's received quantity can be reduced. */
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid

  quantity    Int
  /** The average cost at the moment of posting — what the stock was carried at. */
  unitCostEur Decimal @map("unit_cost_eur") @db.Decimal(14, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  vendorReturn      VendorReturn       @relation(fields: [vendorReturnId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  @@index([vendorReturnId])
  @@index([productId])
  @@map("vendor_return_line")
}

/** Append-only status history for a PO (P6 detail view). One row per transition. */
model PurchaseOrderStatusEvent {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  status          String // the status the PO moved to
  note            String?

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_status_event")
}

/**
 * A non-admin's request to have a submitted PO reopened for editing.
 * Admins unlock directly and never create one of these.
 */
model PurchaseOrderUnlockRequest {
  id              String    @id @default(uuid()) @db.Uuid
  purchaseOrderId String    @map("purchase_order_id") @db.Uuid
  requestedById   String?   @map("requested_by") @db.Uuid
  reason          String?
  status          String    @default("pending") // pending | granted | denied
  decidedById     String?   @map("decided_by") @db.Uuid
  decisionNote    String?   @map("decision_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  decidedAt       DateTime? @map("decided_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([status])
  @@map("purchase_order_unlock_request")
}

/**
 * Append-only history of every change to a product's average cost.
 *
 * A single number on the product can never be explained or audited, so each event keeps
 * the quantities and averages either side of it plus what caused it. Recomputing the
 * product's average from this table in order must reproduce Product.averageCostEur.
 */
model ProductCostEvent {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /** opening | goods_receipt | vendor_return | adjustment */
  reason    String
  /** Document behind it, e.g. a GoodsReceipt id. Free-form so later sources can reuse it. */
  refType   String? @map("ref_type")
  refId     String? @map("ref_id") @db.Uuid
  reference String? // human-readable, e.g. "GR-2026-00007"

  /** Units in (+) or out (-) that this event costed. */
  qtyDelta      Int      @map("qty_delta")
  /** Landed cost per unit for this event, in EUR — goods plus its share of shipping/duty/fees. */
  unitCostEur   Decimal  @map("unit_cost_eur") @db.Decimal(14, 4)
  /** The allocated ancillary portion inside unitCostEur, kept so landed vs goods is explicable. */
  landedAddOnEur Decimal @default(0) @map("landed_add_on_eur") @db.Decimal(14, 4)

  qtyBefore     Int      @map("qty_before")
  avgBeforeEur  Decimal? @map("avg_before_eur") @db.Decimal(14, 4)
  qtyAfter      Int      @map("qty_after")
  avgAfterEur   Decimal  @map("avg_after_eur") @db.Decimal(14, 4)

  notes String?

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([refType, refId])
  @@map("product_cost_event")
}

model ProductSkuAlias {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  skuValue         String  @unique @map("sku_value")
  label            String?
  fulfilmentTypeId String? @map("fulfilment_type_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  fulfilmentType FulfilmentType? @relation(fields: [fulfilmentTypeId], references: [id], onDelete: SetNull)

  @@map("product_sku_alias")
}

model ProductMedia {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

// The real product↔attribute assignment (distinct from the M2 `attribute` library).
model ProductAttribute {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @map("product_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  // A product may carry an attribute more than once (multi-value attributes), so uniqueness
  // is per distinct value — the same attribute+value can't be recorded twice on one product.
  @@unique([productId, attributeId, value])
  @@map("product_attribute")
}

model ProductCompany {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId])
  @@map("product_company")
}

// ===========================================================================
// Global Data: Countries, Shipping Services, Sales Channels.
// Currencies are handled as ISO 4217 3-letter codes (stored as strings; a static
// list backs the dropdowns) — no table needed.
// ===========================================================================

model Country {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String   // ISO official name
  isoCode                  String   @unique @map("iso_code") // 2-char alpha-2
  continent                String
  euVatZone                Boolean  @default(false) @map("eu_vat_zone")
  vatRate                  Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  defaultShippingServiceId String?  @map("default_shipping_service_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  defaultShippingService ShippingService?      @relation("CountryDefaultService", fields: [defaultShippingServiceId], references: [id], onDelete: SetNull)
  zoneMemberships        ShippingZoneCountry[]
  shippingZoneMappings   CountryShippingZone[]
  salesChannels          SalesChannel[]
  salesTransactions      SalesTransaction[]
  fbaShipments           FbaShipment[]

  @@map("country")
}

model ShippingService {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  alias      String?
  calcMethod String @map("calc_method") // 'actual_weight' | 'volumetric_weight'
  // Tracking URL template for this courier. A `{tracking}` placeholder is replaced with
  // the shipment's tracking number to build a status/track link (used across modules).
  trackingUrlTemplate String? @map("tracking_url_template")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  zones               ShippingZone[]
  defaultForCountries Country[]             @relation("CountryDefaultService")
  countryMappings     CountryShippingZone[]
  salesTransactions   SalesTransaction[]    @relation("TxShippingService")
  shipments           Shipment[]            @relation("ShipmentShippingService")
  fbaShipments        FbaShipment[]         @relation("FbaShipmentService")

  @@map("shipping_service")
}

model ShippingZone {
  id                String @id @default(uuid()) @db.Uuid
  shippingServiceId String @map("shipping_service_id") @db.Uuid
  name              String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  service         ShippingService       @relation(fields: [shippingServiceId], references: [id], onDelete: Cascade)
  countries       ShippingZoneCountry[]
  rates           ShippingRate[]
  countryMappings CountryShippingZone[]
  fbaShipments    FbaShipment[]

  @@map("shipping_zone")
}

model ShippingZoneCountry {
  id        String @id @default(uuid()) @db.Uuid
  zoneId    String @map("zone_id") @db.Uuid
  countryId String @map("country_id") @db.Uuid

  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  country Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([zoneId, countryId])
  @@map("shipping_zone_country")
}

model ShippingRate {
  id           String  @id @default(uuid()) @db.Uuid
  zoneId       String  @map("zone_id") @db.Uuid
  fromWeightKg Decimal @map("from_weight_kg") @db.Decimal(10, 3)
  toWeightKg   Decimal @map("to_weight_kg") @db.Decimal(10, 3)
  chargeEur    Decimal @map("charge_eur") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rate")
}

// Which zone of a shipping service applies to a country (the Countries custom columns).
model CountryShippingZone {
  id                String @id @default(uuid()) @db.Uuid
  countryId         String @map("country_id") @db.Uuid
  shippingServiceId String @map("shipping_service_id") @db.Uuid
  zoneId            String @map("zone_id") @db.Uuid

  country Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  service ShippingService @relation(fields: [shippingServiceId], references: [id], onDelete: Cascade)
  zone    ShippingZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([countryId, shippingServiceId])
  @@map("country_shipping_zone")
}

model SalesChannel {
  id              String  @id @default(uuid()) @db.Uuid
  // Owning company. Sales channels are company-isolated: each company keeps its own
  // set (two companies may each have their own "Amazon IT"). Never shared across companies.
  companyId       String? @map("company_id") @db.Uuid
  name            String
  description     String?
  // 'online'  — a marketplace/webshop; orders arrive via an integration and the channel reports tax to us.
  // 'local'   — our own direct/walk-in sales, entered by hand: EUR, FX 1, no sales fee, VAT charged by us.
  // Structural rather than editable: it decides which pricing and alert rules apply to a transaction.
  kind            String  @default("online")
  // Whether a transaction Total (net + VAT + buyer-paid shipping + its VAT) is calculated and
  // shown for this channel. Off by default: on a marketplace the channel reports tax in its own
  // way, so a single "total" is often meaningless or misleading. On for our own local sales.
  showTransactionTotal Boolean @default(false) @map("show_transaction_total")
  // Chip colours used wherever the channel name is shown. Seeded from the native country's
  // flag palette, then editable per channel in Global Settings. Null falls back to neutral grey.
  chipBgColor   String? @map("chip_bg_color")
  chipTextColor String? @map("chip_text_color")
  nativeCountryId String? @map("native_country_id") @db.Uuid
  nativeCurrency     String? @map("native_currency") // ISO 4217 3-letter
  generalSalesFeePct Float?  @map("general_sales_fee_pct") // % fee charged per sale
  // Whether the sales fees are charged in the channel's native currency; if not,
  // feeCurrency holds the explicit currency the fees are charged in.
  feeChargedInNativeCurrency Boolean @default(true) @map("fee_charged_in_native_currency")
  feeCurrency                String? @map("fee_currency")
  // Marketplace-collected VAT threshold rule (e.g. UK £135): below/equal the threshold the
  // channel collects VAT at belowPct; above it VAT is import VAT (abovePct, usually 0).
  vatThresholdEnabled  Boolean @default(false) @map("vat_threshold_enabled")
  vatThresholdAmount   Float?  @map("vat_threshold_amount")
  vatThresholdCurrency String? @map("vat_threshold_currency")
  vatBelowThresholdPct Float?  @map("vat_below_threshold_pct")
  vatAboveThresholdPct Float?  @map("vat_above_threshold_pct")
  // Whether the price we LIST on this channel already contains the destination tax.
  //
  // EU marketplaces are quoted VAT-inclusive, so the listed price has to be divided down to
  // reach our revenue. Where the marketplace is the deemed collector and adds the tax on top at
  // checkout -- Amazon AU adding GST for an overseas seller is the case in hand -- the listed
  // price IS our revenue: the tax never belongs to us and dividing it out understates profit and
  // pushes the computed floor above where it should be.
  //
  // Per channel rather than per country: it depends on where we are established relative to the
  // marketplace, so two channels in the same country can legitimately differ.
  pricesIncludeTax Boolean @default(true) @map("prices_include_tax")
  // How far below the market rate this channel actually converts, as a percentage.
  //
  // Some marketplaces convert the whole order themselves and pay out in EUR. eBay does, and their
  // spread is remarkably stable — measured at 3.02% on USD, 3.02% and 3.03% on GBP, and 3.02% on
  // AUD across a month, averaging 3.01%. A spread rather than a fixed rate because the market rate
  // moves daily while the markup does not: a rate entered today is wrong tomorrow, a spread is not.
  //
  // Null = convert at the market rate, which is right for channels that pay out in the currency
  // they collected (Amazon settles that way, and our own bank does the conversion).
  fxSpreadPct   Float?    @map("fx_spread_pct")
  fxSpreadNote  String?   @map("fx_spread_note")
  fxSpreadSetAt DateTime? @map("fx_spread_set_at")
  email              String?
  website            String?
  contactName        String? @map("contact_name")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  nativeCountry     Country?           @relation(fields: [nativeCountryId], references: [id], onDelete: SetNull)
  salesTransactions SalesTransaction[]
  fbaShipments      FbaShipment[]

  @@index([companyId])
  @@map("sales_channel")
}

// ===========================================================================
// Channel Integrations — direct API connections to sales channels (OnBuy first).
// Non-secret config lives on the integration; API keys/secrets are AES-256-GCM
// encrypted in integration_secret and NEVER returned through the API.
// ===========================================================================
model ChannelIntegration {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  channelType    String    @map("channel_type") // connector/family key: 'amazon' | 'ebay' | 'onbuy'
  marketplace    String?   @map("marketplace") // sub-channel id, e.g. 'UK', 'DE'
  config         Json      @default("{}") // non-secret fields (url, sellerId, siteIds, …)
  status         String    @default("active") // active | disabled
  lastTestedAt   DateTime? @map("last_tested_at")
  lastTestStatus String?   @map("last_test_status") // ok | fail
  lastTestMessage String?  @map("last_test_message")
  // Set when the user has reviewed & confirmed the field mapping (gate for import).
  mappingVerifiedAt DateTime? @map("mapping_verified_at")
  // Import settings: where imported orders land, and how the sync runs.
  targetSalesChannelId String?  @map("target_sales_channel_id") @db.Uuid
  targetCompanyId      String?  @map("target_company_id") @db.Uuid
  autoSyncEnabled      Boolean  @default(false) @map("auto_sync_enabled")
  backfillDays         Int      @default(30) @map("backfill_days")
  lastSyncedAt         DateTime? @map("last_synced_at") // high-water mark (max imported order date)
  lastSyncRunAt        DateTime? @map("last_sync_run_at")
  lastSyncStatus       String?   @map("last_sync_status") // ok | error
  lastSyncMessage      String?   @map("last_sync_message")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  secrets IntegrationSecret[]
  audits  IntegrationAudit[]
  channelListings ChannelListing[]
  productPlans    ProductChannelPlan[]

  @@map("channel_integration")
}

// One encrypted secret field (e.g. liveSecretKey). Stores only ciphertext + the
// GCM nonce/tag + key version + last-4 (for masked display). No plaintext, ever.
model IntegrationSecret {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  fieldKey      String   @map("field_key")
  ciphertext    String
  iv            String
  authTag       String   @map("auth_tag")
  keyVersion    Int      @map("key_version")
  last4         String
  updatedAt     DateTime @updatedAt @map("updated_at")

  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, fieldKey])
  @@map("integration_secret")
}

// Audit trail for integrations — who did what, when. Never records secret values.
model IntegrationAudit {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String?  @map("integration_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String // create | update | secret.set | secret.replace | delete | test
  detail        String?
  createdAt     DateTime @default(now()) @map("created_at")

  integration ChannelIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@map("integration_audit")
}

/** Optional brand logo for an integration channel family (Amazon, eBay, OnBuy).
 *  Keyed by the static connector `type`; shown in the Integrations group header
 *  in place of the monogram fallback. One logo per channel type. */
model ChannelLogo {
  id          String @id @default(uuid()) @db.Uuid
  channelType String @unique @map("channel_type")
  url         String

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid

  @@map("channel_logo")
}

// Profit-percentage tiers: colour bands for the Profit (%) chip in the sales
// transaction list (e.g. Tier 1: 1–10% → green chip). Managed in Global Settings.
model ProfitTier {
  id        String @id @default(uuid()) @db.Uuid
  name      String?
  fromPct   Float  @map("from_pct")
  toPct     Float  @map("to_pct")
  bgColor   String @map("bg_color") // CSS colour for the chip background
  fontColor String @map("font_color") // CSS colour for the chip text
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profit_tier")
}

// Official Cyprus Customs monthly exchange rates (units of the foreign currency
// per 1 EUR), pulled from the Cyprus open-data portal (data.gov.cy) for tax use.
model CustomsExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  year         Int
  month        Int // 1-12
  currencyCode String   @map("currency_code") // 3-letter code from the source header
  currencyName String?  @map("currency_name")
  rate         Float // foreign currency units per 1 EUR
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([year, month, currencyCode])
  @@index([year, month])
  @@map("customs_exchange_rate")
}

// Audit log of each pull from the Cyprus customs open-data portal.
model CustomsFxSync {
  id             String    @id @default(uuid()) @db.Uuid
  status         String // 'success' | 'error'
  message        String?
  sourceUrl      String?   @map("source_url")
  sourceModified DateTime? @map("source_modified")
  monthsImported Int       @default(0) @map("months_imported")
  ratesImported  Int       @default(0) @map("rates_imported")
  trigger        String    @default("manual") // 'manual' | 'schedule' | 'startup'
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("customs_fx_sync")
}

// ===========================================================================
// Sales Transactions module — registers sales across all sales channels.
// Header + line items (one per SKU). Amounts stored in the sales channel's
// native currency, except the sales fee which uses the channel's fee currency
// (both snapshotted on the header at registration time).
// ===========================================================================

model SalesTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  date                 DateTime
  transactionRef       String   @map("transaction_ref") // the user's "Transaction ID"
  salesChannelId       String?  @map("sales_channel_id") @db.Uuid
  destinationCountryId String?  @map("destination_country_id") @db.Uuid
  companyId            String?  @map("company_id") @db.Uuid
  currency             String? // native currency snapshot (net/vat/shipping amounts)
  feeCurrency          String?  @map("fee_currency") // fee currency snapshot
  // draft = editable by anyone; submitted = locked (admin edits freely, non-admins need
  // an unlock granted). unlockedForEdit re-opens a submitted transaction to non-admins.
  status          String  @default("draft") // draft | submitted
  unlockedForEdit Boolean @default(false) @map("unlocked_for_edit")
  // Chosen shipping service (defaults to the destination country's default; editable).
  shippingServiceId String? @map("shipping_service_id") @db.Uuid
  // Snapshot: channel currency -> EUR exchange rate at the transaction date.
  exchangeRate Float? @map("exchange_rate")
  // Snapshot: fee currency -> EUR rate (same as exchangeRate when fee is in native currency).
  feeExchangeRate Float? @map("fee_exchange_rate")
  // Destination VAT %: auto-derived (channel threshold rule or country rate) unless the
  // user overrides it (vatOverridden = true keeps the manual value on re-save).
  destinationVatPct Float?  @map("destination_vat_pct")
  vatOverridden     Boolean @default(false) @map("vat_overridden")
  // Destination tax regime for this sale, so reports can separate VAT from GST (AU),
  // Japanese Consumption Tax (JP) and US-style sales tax. Derived from the destination
  // country and snapshotted at sale time. vat | gst | jct | sales_tax | none.
  taxType           String? @map("tax_type")
  // Fulfilment lifecycle (operations): 'cancelled' is used by the returns layer. The
  // platform "shipped" state is derived from whether an outbound shipment is registered
  // in the Shipments module — this stored value is no longer the source of truth for it.
  fulfilmentStatus String @default("pending") @map("fulfilment_status") // pending | shipped | cancelled
  // Shipment status as reported by the sales channel's API (e.g. OnBuy shipped_at/dispatched).
  // Kept separate from the platform status so a mismatch can later raise an alarm.
  channelShipmentStatus String? @map("channel_shipment_status") // shipped | not_shipped
  // How the order was fulfilled, from the channel (Amazon FulfillmentChannel: AFN→FBA, MFN→FBM).
  // Drives the profit cost basis: FBM = purchase cost + outbound shipping; FBA = purchase cost +
  // average inbound-to-Amazon cost + Amazon FBA fulfilment fee. Null where the concept doesn't apply.
  fulfilmentType String? @map("fulfilment_type") // FBA | FBM
  // Local sales only. There is no carrier, weight or zone to estimate from, so the cost is
  // entered ad-hoc per transaction and the delivery method is just a label for the record.
  deliveryMethod      String? @map("delivery_method") // pickup | own_delivery
  localShippingCostEur Float? @map("local_shipping_cost_eur")
  // Sale-level discount, spread across the lines in proportion to their net so each line's
  // VAT falls with it. Stored as entered ('percentage' of the net total, or a fixed EUR
  // amount) so reopening the sale shows what was actually keyed in, not a derived figure.
  discountType  String? @map("discount_type") // percentage | fixed
  discountValue Float?  @map("discount_value")
  // Whether the discount is taken off the net total ('net', default) or the
  // VAT-inclusive total ('gross'). Only changes the maths for a fixed amount.
  discountBase  String? @map("discount_base") // net | gross
  // Order resolution (returns/cancellations/refunds). Adjusts revenue/COGS in the profit calc.
  resolution      String   @default("none") @map("resolution") // none | cancelled | returned | replaced
  /// For a cancelled order, WHEN it was cancelled. 'pending' = cancelled while still in Amazon's
  /// Pending state, so it never became an order: no payment taken, nothing shipped, nothing to
  /// decide. 'placed' = a confirmed order cancelled before dispatch. Null on legacy rows and on
  /// channels that do not report it — those keep the old undifferentiated display.
  /// Both stay resolution='cancelled': they are equally cancelled and equally neutral to profit.
  /// Splitting the resolution instead would have meant auditing 45 `resolution === 'cancelled'`
  /// checks across profit, analytics and fulfilment for a distinction none of them care about.
  cancelStage     String?  @map("cancel_stage") // pending | placed
  refundAmount    Float?   @map("refund_amount") // our-revenue portion refunded (net+shipping, exc VAT), native currency
  restockItems    Boolean  @default(false) @map("restock_items") // returned goods resellable → reverse COGS
  feeRefunded     Boolean  @default(false) @map("fee_refunded") // channel refunded its selling fee
  resolutionNotes String?  @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at")
  // Where a returned FBM unit was physically put back (null = not restocked). Its presence
  // encodes "restocked"; the warehouse's include_in_inventory flag decides resellability,
  // which in turn drives restockItems (reverse COGS) vs keeping the cost as a loss. FBA
  // returns never set this — the goods go back to Amazon, not to us.
  returnWarehouseId String? @map("return_warehouse_id") @db.Uuid
  // Set once the operator has made the return decision on a defective (cancelled/refunded)
  // order. A refund pulled from Amazon lands with this false — the "needs action" worklist.
  returnHandled   Boolean  @default(false) @map("return_handled")
  // Who set the resolution: 'manual' (operator) or 'amazon' (auto-ingested). Lets a re-sync
  // apply a fresh refund without ever clobbering a decision the operator already made.
  resolutionSource String? @map("resolution_source") // manual | amazon
  // Provenance: 'manual' or an importer key like 'onbuy'; integrationId links the
  // source integration so a re-sync only ever touches its own imported records.
  source        String  @default("manual") @map("source")
  integrationId String? @map("integration_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  salesChannel       SalesChannel?    @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  destinationCountry Country?         @relation(fields: [destinationCountryId], references: [id], onDelete: SetNull)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shippingService    ShippingService? @relation("TxShippingService", fields: [shippingServiceId], references: [id], onDelete: SetNull)
  stockOwed          StockOwed[]
  items              SalesTransactionItem[]
  unlockRequests     SalesTransactionUnlockRequest[]
  shipments          Shipment[]

  // Company isolation filters every read by companyId, and lists/analytics sort &
  // range by date — this composite serves both. The rest match the hot filters and
  // the import dedup lookup (integrationId + transactionRef).
  @@index([companyId, date])
  @@index([deletedAt])
  @@index([integrationId, transactionRef])
  @@index([salesChannelId])
  @@index([destinationCountryId])
  @@map("sales_transaction")
}

// A physical shipment for a sales transaction (operations records actuals here).
// Outbound = to the customer; inbound = a return/receipt. The actual outbound
// shipping cost overrides the transaction's calculated estimate; duty and any
// company-borne return shipping are added as extra costs in the profit calc.
model Shipment {
  id                String   @id @default(uuid()) @db.Uuid
  transactionId     String   @map("transaction_id") @db.Uuid
  type              String   @default("outbound") // outbound | inbound
  shipmentDate      DateTime @map("shipment_date")
  shippingServiceId String?  @map("shipping_service_id") @db.Uuid
  trackingNumber    String?  @map("tracking_number")
  shippingCostEur   Float?   @map("shipping_cost_eur") // actual shipping cost, exc VAT, in EUR
  costBorneBy       String   @default("company") @map("cost_borne_by") // company | customer
  dutyImportEur     Float?   @map("duty_import_eur") // duty / import charges, in EUR
  comments          String?
  // Set when several orders ship together as one physical parcel: all their shipment rows
  // share this id, and the one real cost is split across them (see ShipmentsService.combine).
  groupId           String?  @map("group_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  transaction     SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  shippingService ShippingService? @relation("ShipmentShippingService", fields: [shippingServiceId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([groupId])
  @@map("shipment")
}

model SalesTransactionUnlockRequest {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @map("transaction_id") @db.Uuid
  requestedById String?   @map("requested_by") @db.Uuid
  status        String    @default("pending") // pending | granted | denied
  decidedById   String?   @map("decided_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("sales_transaction_unlock_request")
}

model SalesTransactionItem {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  sku           String
  /**
   * Units sold. Decimal because some goods are sold by length or weight — 1.5 is a real line.
   *
   * The stock ledger is still integer, so a fractional line cannot be deducted from stock; the
   * sales service refuses rather than rounding, since a silently rounded stock figure is worse
   * than a refused sale.
   */
  quantity      Decimal @default(1) @db.Decimal(14, 3)

  netSalesAmount             Float? @map("net_sales_amount")
  vatAmount                  Float? @map("vat_amount")
  shippingAmount             Float? @map("shipping_amount")
  shippingAmountVat          Float? @map("shipping_amount_vat")
  salesChannelSalesFeeAmount Float? @map("sales_channel_sales_fee_amount") // referral / selling fee (excludes FBA)
  fbaFulfilmentFeeAmount     Float? @map("fba_fulfilment_fee_amount")      // Amazon FBA fulfilment fee (FBA orders)
  amazonPointsAmount         Float? @map("amazon_points_amount")           // Amazon Points awarded (JP); a deduction from our proceeds
  salesTaxAmount             Float? @map("sales_tax_amount")               // total tax the channel charged (item+shipping); reporting only, not used in calcs

  // Per-line unit purchase cost override (EUR). When set, it replaces the product's stored
  // purchase cost in this transaction's profit calc — for the times the actual cost of the
  // goods sold differed from the catalogue cost. Null = use the product's cost as usual.
  unitNetCostEur Float? @map("unit_net_cost_eur")

  // COGS frozen at the moment the sale was created or pulled from the channel.
  //
  // Revenue and profit are always computed from the product data in place at that time: a later
  // purchase-cost change applies from that point forward and never restates a sale already
  // recorded. Without this the cost resolved at READ time, so re-costing a product silently
  // rewrote the reported profit of every past sale of it — which a vendor price-file upload
  // would do to a thousand products at once.
  //
  // Preserved across an edit: re-saving a transaction must not refresh its cost.
  // Null means nothing was known when the sale was recorded; those lines keep resolving live
  // until a cost exists, then freeze.
  unitCostSnapshotEur Decimal?  @map("unit_cost_snapshot_eur") @db.Decimal(14, 4)
  /** Where the frozen cost came from: average | catalogue. */
  costSnapshotSource  String?   @map("cost_snapshot_source")
  costSnapshotAt      DateTime? @map("cost_snapshot_at")

  // Per-line VAT snapshot, written for local sales where we are the one charging VAT.
  // The rate is copied in at save time so changing a VatClass later never rewrites
  // historical sales; the class id is kept alongside it for reporting (a VAT return
  // needs zero-rated and exempt separated, and both are 0%).
  vatClassId String? @map("vat_class_id") @db.Uuid
  vatRatePct Float?  @map("vat_rate_pct")

  // How many units of this line have been taken off physical stock, and from where.
  // Only used when "deduct stock on sale" is on; lets a re-submit deduct just the delta
  // and an un-submit put back exactly what it took. The remainder that stock couldn't
  // cover is carried as StockOwed, not here.
  stockDeductedQty  Int     @default(0) @map("stock_deducted_qty")
  stockWarehouseId  String? @map("stock_warehouse_id") @db.Uuid

  // How many units of this line have been taken off channel Availability (the sellable number
  // broadcast to every channel). Independent of physical stock: a sale on any channel lowers
  // the shared pool so the other channels can be told the new figure. Only used when
  // "auto-adjust availability on sale" is on; lets a re-submit move just the delta and an
  // un-submit/cancel add it back.
  availabilityDeductedQty Int @default(0) @map("availability_deducted_qty")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  vatClass    VatClass?        @relation(fields: [vatClassId], references: [id], onDelete: SetNull)

  // transactionId is the FK join for every `include: { items }` (sales lists +
  // analytics); productId/sku power product-level rollups and SKU relinking.
  @@index([transactionId])
  @@index([productId])
  @@index([sku])
  @@map("sales_transaction_item")
}

// ===========================================================================
// FBA Shipments — shipments of our stock TO Amazon Fulfilment Centers.
// Used to estimate (and later record the actual) inbound shipping cost and to
// derive each SKU's average allocated inbound cost per sales channel, which
// feeds the profit calc for FBA orders.
// ===========================================================================
model FbaShipment {
  id                   String  @id @default(uuid()) @db.Uuid
  // Owning company. FBA shipments are company-isolated.
  companyId            String? @map("company_id") @db.Uuid
  date                 DateTime
  salesChannelId       String? @map("sales_channel_id") @db.Uuid
  // Snapshot of the channel's native country at creation (the destination).
  destinationCountryId String? @map("destination_country_id") @db.Uuid
  // Unique FBA shipment identifier generated by the target sales channel (Amazon).
  fbaShipmentRef       String? @map("fba_shipment_ref")
  shippingServiceId    String? @map("shipping_service_id") @db.Uuid
  // Snapshot of the resolved zone + calc method at estimate time.
  shippingZoneId       String? @map("shipping_zone_id") @db.Uuid
  calcMethod           String? @map("calc_method") // 'actual_weight' | 'volumetric_weight'
  // Packaging uplift % added on top of summed product weight (actual-weight services).
  packagingPct         Decimal @default(10) @map("packaging_pct") @db.Decimal(6, 2)
  // Raw summed basis weight (before packaging) and the final weight used for the rate band.
  basisWeightKg        Decimal? @map("basis_weight_kg") @db.Decimal(12, 3)
  chargeableWeightKg   Decimal? @map("chargeable_weight_kg") @db.Decimal(12, 3)
  estimatedCostEur     Decimal? @map("estimated_cost_eur") @db.Decimal(12, 2)
  // Actual cost registered by operations; when set it overrides the estimate for allocation.
  actualCostEur        Decimal? @map("actual_cost_eur") @db.Decimal(12, 2)
  status               String  @default("draft") // draft | confirmed
  comments             String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  // Total empty-box weight (Σ box weights) snapshotted at estimate time.
  emptyBoxesWeightKg Decimal? @map("empty_boxes_weight_kg") @db.Decimal(12, 3)

  salesChannel       SalesChannel?    @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  destinationCountry Country?         @relation(fields: [destinationCountryId], references: [id], onDelete: SetNull)
  shippingService    ShippingService? @relation("FbaShipmentService", fields: [shippingServiceId], references: [id], onDelete: SetNull)
  shippingZone       ShippingZone?    @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  boxes              FbaShipmentBox[]
  items              FbaShipmentItem[]

  @@index([salesChannelId])
  @@index([companyId])
  @@map("fba_shipment")
}

// A physical box within an FBA shipment. Holds its own empty weight + dimensions
// (so the box weight/volume feeds the shipping-cost calc) and an optional tracking
// number added later by operations (boxes may share or have distinct tracking).
model FbaShipmentBox {
  id             String  @id @default(uuid()) @db.Uuid
  shipmentId     String  @map("shipment_id") @db.Uuid
  label          String? // e.g. "Box 1"
  emptyWeightKg  Decimal? @map("empty_weight_kg") @db.Decimal(12, 3)
  lengthCm       Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm        Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(10, 2)
  trackingNumber String? @map("tracking_number")
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  shipment FbaShipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items    FbaShipmentItem[]

  @@index([shipmentId])
  @@map("fba_shipment_box")
}

model FbaShipmentItem {
  id         String  @id @default(uuid()) @db.Uuid
  shipmentId String  @map("shipment_id") @db.Uuid
  boxId      String? @map("box_id") @db.Uuid
  productId  String? @map("product_id") @db.Uuid
  sku        String
  title      String? // snapshot of the product title at add time
  quantity   Int     @default(1)
  // Per-unit basis weight used for allocation (actual or volumetric per the service).
  unitWeightKg         Decimal? @map("unit_weight_kg") @db.Decimal(12, 3)
  // Shipping cost allocated to this line (effective cost × its weight×qty share).
  allocatedCostEur     Decimal? @map("allocated_cost_eur") @db.Decimal(12, 4)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  shipment FbaShipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  box      FbaShipmentBox? @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([boxId])
  @@index([productId])
  @@map("fba_shipment_item")
}

// ---------------------------------------------------------------------------
// Expenses (operating expenses; COGS stays in Purchase Orders)
// ---------------------------------------------------------------------------

// Arbitrary-depth category tree (Category → sub-category → …). Mirrors Warehouse.
model ExpenseCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  parent      ExpenseCategory?    @relation("ExpenseCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ExpenseCategory[]   @relation("ExpenseCategoryTree")
  definitions ExpenseDefinition[]

  @@index([parentId])
  @@map("expense_category")
}

// Reusable expense definition ("Salary", "Office Cleaning"). Occurrence lives on the
// registration; defaultOccurrence only pre-fills the form.
model ExpenseDefinition {
  id                String  @id @default(uuid()) @db.Uuid
  code              String  @unique // platform-assigned Expense ID, e.g. EXP-0001
  name              String
  categoryId        String? @map("category_id") @db.Uuid
  defaultOccurrence String? @map("default_occurrence") // monthly | annual | once_off
  isActive          Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([categoryId])
  @@map("expense_definition")
}

// A registered expense — recurring (monthly/annual) or once-off. Amounts are held in
// effective-dated ExpenseAmount rows (+ per-month overrides), so any month is computed
// on read. Cancel sets endMonth/status; rows are never hard-deleted once ledgered.
model Expense {
  id           String    @id @default(uuid()) @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  occurrence   String // monthly | annual | once_off
  currency     String    @default("EUR")
  // Recurring: first month it applies (supports back-dating), 'YYYY-MM'. Once-off: the
  // month derived from onceOffDate.
  startMonth   String    @map("start_month")
  // Last active month for a recurring expense, 'YYYY-MM'; null = ongoing. Set on cancel.
  endMonth     String?   @map("end_month")
  // Once-off only: the actual expense date (its month drives where it lands).
  onceOffDate  DateTime? @map("once_off_date")
  status       String    @default("active") // active | cancelled
  note         String?
  // Optional tracking tag (e.g. a specific car by plate) for per-thing reporting.
  tagId        String?   @map("tag_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  definition ExpenseDefinition      @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag        ExpenseTag?            @relation(fields: [tagId], references: [id], onDelete: SetNull)
  amounts    ExpenseAmount[]
  overrides  ExpenseMonthOverride[]

  @@index([definitionId])
  @@index([companyId])
  @@index([tagId])
  @@map("expense")
}

// Tracking tags for per-thing reporting (e.g. a specific company car by plate). Each tag has a
// value (name) and an optional group (e.g. "Cars"), so reports can slice one tag or a whole group.
model ExpenseTag {
  id          String  @id @default(uuid()) @db.Uuid
  name        String // the value, e.g. "CY-1234 — Toyota Yaris"
  group       String? // optional grouping, e.g. "Cars"
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  expenses Expense[]

  @@map("expense_tag")
}

// Effective-dated base amount. A new row from month M is the "apply to all following
// months" change; the value in effect for a month is the latest row with effectiveMonth <= M.
model ExpenseAmount {
  id             String  @id @default(uuid()) @db.Uuid
  expenseId      String  @map("expense_id") @db.Uuid
  effectiveMonth String  @map("effective_month") // 'YYYY-MM'
  amount         Decimal @db.Decimal(14, 2) // in the expense's currency
  amountEur      Decimal @map("amount_eur") @db.Decimal(14, 2) // converted at booking
  fxRate         Decimal? @map("fx_rate") @db.Decimal(18, 8) // EUR per 1 unit of currency

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_amount")
}

// "Apply to this month only" — a single-month override that wins over the effective amount.
model ExpenseMonthOverride {
  id        String  @id @default(uuid()) @db.Uuid
  expenseId String  @map("expense_id") @db.Uuid
  month     String // 'YYYY-MM'
  amount    Decimal @db.Decimal(14, 2)
  amountEur Decimal @map("amount_eur") @db.Decimal(14, 2)
  fxRate    Decimal? @map("fx_rate") @db.Decimal(18, 8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, month])
  @@map("expense_month_override")
}

// ===========================================================================
// Amazon repricing (Module: Amazon Buy Box algorithmic repricing — spec §4.1)
// ---------------------------------------------------------------------------
// The spec's MongoDB collections translated to Postgres (findings §A/§G). This module keeps
// its own INTEGER-CENTS money discipline (Int columns named *Cents) rather than the ERP's Float
// EUR, to avoid rounding drift in the solver and every competitor comparison (Deviation D-3).
// companyId / productId are plain UUID scalars (no relations) — the same "audit rows survive
// independently" pattern as ChannelPush; joins happen by business key (sku/asin/marketplaceId).
// Verbatim Amazon payloads are kept as jsonb.
// ===========================================================================

// One row per SKU × marketplace — the engine's per-listing config AND live state (spec §4.1).
model RepricingSkuPricing {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String? @map("company_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid // null = not matched to our catalogue → excluded
  sku           String
  asin          String?
  marketplaceId String  @map("marketplace_id") // Amazon marketplace id, e.g. A1PA6795UKMFR9
  currency      String  @default("EUR")

  fulfillment     String // FBA | FBM | SFP
  strategy        String @default("BUY_BOX") // BUY_BOX | LOWEST_PRICE | VELOCITY | MANUAL_ONLY
  /// Named preset this SKU follows. Per-SKU overrides below still win over it.
  presetId        String? @map("preset_id") @db.Uuid
  preset          RepricingStrategyPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  automationState String @default("EXCLUDED") @map("automation_state") // EXCLUDED | SHADOW | LIVE | QUARANTINED | KILLED
  exclusionReason String? @map("exclusion_reason") // e.g. FLOOR_UNKNOWN, COGS_MISSING, FLOOR_STALE

  // Floors (§4.3) — absolute never-cross line + strategy floor. Null ⇒ EXCLUDED.
  breakevenCents     Int?      @map("breakeven_cents")
  strategyFloorCents Int?      @map("strategy_floor_cents")
  floorsComputedAt   DateTime? @map("floors_computed_at")
  floorStaleAfter    DateTime? @map("floor_stale_after") // past this ⇒ automationState → EXCLUDED
  floorInputsHash    String?   @map("floor_inputs_hash") // hash of fee+cost inputs, for audit

  // Ceilings (§6.2) — cents.
  maxPriceCents           Int? @map("max_price_cents")
  fairPricingCeilingCents Int? @map("fair_pricing_ceiling_cents")
  amazonMinAllowedCents   Int? @map("amazon_min_allowed_cents")
  amazonMaxAllowedCents   Int? @map("amazon_max_allowed_cents")

  // Per-SKU parameter overrides; null ⇒ strategy-group default (§4.1 params, §9). Percentages
  // stored as percent values (1.0000 = 1%).
  epsilonCents         Int?     @map("epsilon_cents")
  cooldownSeconds      Int?     @map("cooldown_seconds")
  probeStepPct         Decimal? @map("probe_step_pct") @db.Decimal(6, 4)
  probeIntervalMinutes Int?     @map("probe_interval_minutes")
  fbmPremiumPct        Decimal? @map("fbm_premium_pct") @db.Decimal(6, 4)
  minMarginPct         Decimal? @map("min_margin_pct") @db.Decimal(6, 4)
  // Loaded-cost inputs the solver has always accepted and nothing supplied, leaving every floor a
  // fee-and-cost breakeven. Harmless at a 12% margin, where the omission hides inside the margin;
  // not harmless at the low floors an aggressive strategy wants.
  //
  // Returns are derived from our own sales history and stored here so a floor can be explained
  // without re-deriving it. Storage and advertising need Amazon's FBA storage reports and the
  // Advertising API, neither of which we pull, so they are set by hand or left out and REPORTED
  // as left out rather than silently treated as zero.
  returnsRatePct           Decimal? @map("returns_rate_pct") @db.Decimal(6, 4)
  returnsRateSource        String?  @map("returns_rate_source") // sku | marketplace | default
  storagePerUnitCents      Int?     @map("storage_per_unit_cents")
  adCostPerUnitCents       Int?     @map("ad_cost_per_unit_cents")
  /// Which cost components the stored floor accounts for, so a low floor can be trusted on evidence.
  floorOmits               String[] @map("floor_omits")

  // Volatile engine state (§4.1 state block).
  currentPriceCents       Int?      @map("current_price_cents")
  lastSubmittedPriceCents Int?      @map("last_submitted_price_cents")
  lastSubmissionAt        DateTime? @map("last_submission_at")
  lastSubmissionStatus    String?   @map("last_submission_status") // PENDING | ACCEPTED | REJECTED
  holdingBuyBox           Boolean   @default(false) @map("holding_buy_box")
  holdSince               DateTime? @map("hold_since")
  probeAnchorCents        Int?      @map("probe_anchor_cents") // last known-winning price
  undercutLoop            Json?     @map("undercut_loop") // { sellerId, count, windowStart }
  suppressed              Boolean   @default(false)
  lastEventAt             DateTime? @map("last_event_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@unique([marketplaceId, sku])
  @@index([asin, marketplaceId])
  @@index([automationState])
  @@index([floorStaleAfter])
  @@index([productId])
  @@map("repricing_sku_pricing")
}

// Latest market picture per ASIN × marketplace (spec §4.1 offerSnapshots). Upserted on each
// event, so one row = the freshest snapshot; timeOfOfferChange drives stale-event discard.
model RepricingOfferSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  asin              String
  marketplaceId     String   @map("marketplace_id")
  timeOfOfferChange DateTime @map("time_of_offer_change") // from payload
  summary           Json // verbatim Summary block from ANY_OFFER_CHANGED
  offers            Json // verbatim top-20 Offers[]
  source            String // ANY_OFFER_CHANGED | BACKFILL_POLL

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([asin, marketplaceId])
  @@index([marketplaceId])
  @@map("repricing_offer_snapshot")
}

// Append-only decision audit (spec §6.6) — one row per evaluation, INCLUDING no-ops and vetoes.
// Retention ≥ 24 months (enforced operationally, not by schema). Never soft-deleted.
/// A named bundle of the repricing parameters that already existed per SKU.
///
/// Referenced, not copied: a SKU points at a preset and the values resolve at read time, so
/// changing "Clear stock" moves every SKU on it. The per-SKU override columns remain for the
/// exceptions, and win over the preset.
/// Which loaded costs a marketplace actually incurs.
///
/// Storage exists only where stock sits at Amazon, and MASQ is FBA on one marketplace; advertising
/// only where we advertise, which is nowhere today. Both default OFF, so a cost we never incur is
/// not treated as a missing input — a guard that fires on an irrelevant cost protects nothing.
model RepricingMarketplaceCosts {
  marketplaceId String  @id @map("marketplace_id")
  storageApplies Boolean @default(false) @map("storage_applies")
  adsApply       Boolean @default(false) @map("ads_apply")
  /// Used when a SKU carries no value of its own. Null = the SKU must supply one.
  defaultStoragePerUnitCents Int? @map("default_storage_per_unit_cents")
  defaultAdCostPerUnitCents  Int? @map("default_ad_cost_per_unit_cents")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("repricing_marketplace_costs")
}

model RepricingStrategyPreset {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  /// Seeded presets cannot be deleted — a SKU pointing at a missing preset would silently fall
  /// back to defaults, which is the kind of quiet change this feature exists to avoid.
  isSystem    Boolean @default(false) @map("is_system")
  sortOrder   Int     @default(0) @map("sort_order")

  /// BUY_BOX | LOWEST_PRICE | VELOCITY | MANUAL_ONLY
  strategy    String  @default("BUY_BOX")
  minMarginPct         Decimal  @map("min_margin_pct") @db.Decimal(6, 4)
  probeStepPct         Decimal? @map("probe_step_pct") @db.Decimal(6, 4)
  probeIntervalMinutes Int?     @map("probe_interval_minutes")
  fbmPremiumPct        Decimal? @map("fbm_premium_pct") @db.Decimal(6, 4)
  epsilonCents         Int?     @map("epsilon_cents")

  /// Below this margin a floor that omits storage or advertising is not merely optimistic, it is
  /// wrong in a way that reports a loss as a profit. Presets under it refuse SKUs whose floor is
  /// not fully loaded.
  requiresLoadedFloor Boolean @default(false) @map("requires_loaded_floor")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  skus RepricingSkuPricing[]

  @@map("repricing_strategy_preset")
}

model RepricingDecision {
  id                String    @id @default(uuid()) @db.Uuid
  sku               String
  marketplaceId     String    @map("marketplace_id")
  asin              String?
  at                DateTime  @default(now())
  triggerType       String    @map("trigger_type") // ANY_OFFER_CHANGED | PRICING_HEALTH | FEE_PROMOTION | HOLD_TIMER | BACKFILL | MANUAL | ERP_EVENT
  notificationId    String?   @map("notification_id")
  timeOfOfferChange DateTime? @map("time_of_offer_change")
  branch            String? // A | B | C | D | SKIPPED
  strategy          String?
  outcome           String // SUBMITTED | HELD | SKIPPED | QUARANTINED | VETOED | NO_CHANGE
  rawTargetCents    Int?      @map("raw_target_cents")
  finalPriceCents   Int?      @map("final_price_cents")
  beforePriceCents  Int?      @map("before_price_cents")
  buyBoxLandedCents Int?      @map("buy_box_landed_cents") // observed Buy Box landed at eval time — trailing-median source (§6.1/§6.2)
  /// Why this decision came out as it did — the conflict that quarantined it, or why it held.
  /// Computed on every decision and previously only logged, which left the quarantine queue
  /// listing SKUs with no way to tell what was wrong with them.
  reason            String?
  clamps            Json? // each clamp with bind/no-bind (§5.5)
  competitorSet     Json?     @map("competitor_set") // post-filter effective set, with drop reasons
  safetyVerdict     Json?     @map("safety_verdict") // §6.3 boring-layer verdict
  submissionId      String?   @map("submission_id")
  submissionStatus  String?   @map("submission_status")
  engineVersion     String?   @map("engine_version")
  configHash        String?   @map("config_hash")
  inputsHash        String?   @map("inputs_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sku, marketplaceId, at])
  @@index([outcome])
  @@map("repricing_decision")
}

// Blocklist + observed seller metadata (spec §4.1 sellers, §5.2). marketplaceId null ⇒ all markets.
model RepricingBlockedSeller {
  id               String  @id @default(uuid()) @db.Uuid
  marketplaceId    String? @map("marketplace_id")
  sellerId         String  @map("seller_id")
  sellerName       String? @map("seller_name")
  reason           String? // UNAUTHORIZED | MAP_VIOLATOR | HIJACKER | OTHER
  brand            String?
  active           Boolean @default(true)
  observedMetadata Json?   @map("observed_metadata")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@unique([marketplaceId, sellerId])
  @@index([sellerId])
  @@map("repricing_blocked_seller")
}

// Per-SKU getMyFeesEstimate results (spec §4.1 feeCache, §4.3). Fees are DATA, refreshed nightly
// and on FEE_PROMOTION — never hard-coded. One row per fetch (history), latest by fetchedAt.
model RepricingFeeEstimate {
  id                     String   @id @default(uuid()) @db.Uuid
  sku                    String
  asin                   String?
  marketplaceId          String   @map("marketplace_id")
  priceCents             Int      @map("price_cents") // price the estimate was requested at
  referralFeeCents       Int?     @map("referral_fee_cents")
  fbaFulfillmentFeeCents Int?     @map("fba_fulfillment_fee_cents")
  closingFeeCents        Int?     @map("closing_fee_cents")
  totalFeeCents          Int?     @map("total_fee_cents")
  raw                    Json? // verbatim getMyFeesEstimate response
  fetchedAt              DateTime @default(now()) @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sku, marketplaceId, fetchedAt])
  @@map("repricing_fee_estimate")
}

// NotificationId dedupe (spec §4.1 notifDedupe, §2.2). Postgres has no native TTL, so a nightly
// @Cron sweep deletes rows past expiresAt (default receivedAt + 24h).
model RepricingNotifDedupe {
  id               String   @id @default(uuid()) @db.Uuid
  notificationId   String   @unique @map("notification_id")
  notificationType String?  @map("notification_type")
  receivedAt       DateTime @default(now()) @map("received_at")
  expiresAt        DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("repricing_notif_dedupe")
}

// Global runtime controls for the price-writer (spec §6.4). A single row (id="singleton"). These
// are DB-backed so ops can flip them at runtime WITHOUT a redeploy — the whole point of a kill
// switch (you can't redeploy to stop a price war). An env kill switch (AMZ_REPRICING_KILL_SWITCH)
// remains an additional last-resort hard stop that ORs with this.
model RepricingControl {
  id                String   @id @default("singleton")
  liveWritesEnabled Boolean  @default(false) @map("live_writes_enabled")
  killSwitchEngaged Boolean  @default(false) @map("kill_switch_engaged")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedById       String?  @map("updated_by") @db.Uuid

  @@map("repricing_control")
}
