// maSquare — Module 1 (Foundation) data model.
// Conventions (Module 1 §7): UUID keys; audit columns created_at/updated_at/
// created_by/updated_by; soft-delete via deleted_at. created_by/updated_by hold the
// acting user's id (kept as plain UUIDs, not relations, to avoid a tangle of User
// back-relations). Link tables carry timestamps + soft-delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------
model Company {
  id                 String   @id @default(uuid()) @db.Uuid
  officialName       String   @map("official_name")
  registrationNumber String?  @map("registration_number")
  addressLine1       String?  @map("address_line1")
  addressLine2       String?  @map("address_line2")
  addressCity        String?  @map("address_city")
  addressRegion      String?  @map("address_region")
  addressPostalCode  String?  @map("address_postal_code")
  addressCountry     String?  @map("address_country")
  email              String?
  website            String?
  phoneLandline      String?  @map("phone_landline")
  phoneMobile        String?  @map("phone_mobile")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  vatRegistrations  CompanyVatRegistration[]
  contactPersons    CompanyContactPerson[]
  companyModules    CompanyModule[]
  moduleSharings    ModuleSharing[]
  userCompanyAccess UserCompanyAccess[]
  productCompanies  ProductCompany[]
  salesTransactions SalesTransaction[]

  @@map("company")
}

model CompanyVatRegistration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  country   String
  vatNumber String @map("vat_number")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_vat_registration")
}

model CompanyContactPerson {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  surname   String?
  email     String?
  phone     String?
  role      String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_contact_person")
}

// ---------------------------------------------------------------------------
// Modules catalogue, enablement & sharing
// ---------------------------------------------------------------------------
model Module {
  id        String  @id @default(uuid()) @db.Uuid
  key       String  @unique
  name      String
  status    String? // e.g. "core", "module-2", "future"
  isCore    Boolean @default(false) @map("is_core")
  shareable Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyModules   CompanyModule[]
  moduleSharings   ModuleSharing[]
  userModuleAccess UserModuleAccess[]

  @@map("module")
}

model CompanyModule {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  moduleId  String  @map("module_id") @db.Uuid
  enabled   Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_module")
}

model ModuleSharing {
  id        String @id @default(uuid()) @db.Uuid
  moduleId  String @map("module_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([moduleId, companyId])
  @@map("module_sharing")
}

// ---------------------------------------------------------------------------
// Users & access grants
// ---------------------------------------------------------------------------
model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  isAdmin      Boolean    @default(false) @map("is_admin")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  companyAccess UserCompanyAccess[]
  moduleAccess  UserModuleAccess[]

  @@map("user")
}

model UserCompanyAccess {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_company_access")
}

model UserModuleAccess {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  moduleId String @map("module_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_module_access")
}

// product_company (Module 3) — the co-ownership link for shared Products — is defined
// with the Product entity in Module 3. Named in M1 §3 for completeness; not created yet.

// ===========================================================================
// Module 2 — Global Settings: platform-global product reference data.
// (Note: the M2 spec's ERD labels the attribute library "product_attribute";
//  we name it `attribute`/`attribute_value` here so it doesn't collide with the
//  M3 product↔attribute assignment join, which is the real `product_attribute`.)
// ===========================================================================

enum ContactType {
  person
  department
}

enum AttributeInputType {
  predefined
  free_text
}

enum MeasurementSystem {
  metric
  imperial
}

enum DateFormat {
  ddmmyyyy // dd/mm/yyyy (default)
  mmddyyyy // mm/dd/yyyy
  yyyymmdd // yyyy-mm-dd
}

model Vendor {
  id                String  @id @default(uuid()) @db.Uuid
  name              String
  vatNumber         String? @map("vat_number")
  addressLine1      String? @map("address_line1")
  addressLine2      String? @map("address_line2")
  addressCity       String? @map("address_city")
  addressRegion     String? @map("address_region")
  addressPostalCode String? @map("address_postal_code")
  addressCountry    String? @map("address_country")
  phone             String?
  email             String?
  website           String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  contacts VendorContact[]
  products Product[]

  @@map("vendor")
}

model VendorContact {
  id           String       @id @default(uuid()) @db.Uuid
  vendorId     String       @map("vendor_id") @db.Uuid
  contactName  String?      @map("contact_name")
  contactPhone String?      @map("contact_phone")
  contactEmail String?      @map("contact_email")
  contactType  ContactType? @map("contact_type")
  contactRole  String?      @map("contact_role")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_contact")
}

model Brand {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  website String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("brand")
}

model ProductType {
  id   String @id @default(uuid()) @db.Uuid
  name String

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("product_type")
}

model FulfilmentType {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  code   String?
  active Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  products Product[]
  aliases  ProductSkuAlias[]

  @@map("fulfilment_type")
}

model ProductCategory {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  parentId  String? @map("parent_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_category")
}

model Attribute {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  inputType AttributeInputType @map("input_type")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  values            AttributeValue[]
  productAttributes ProductAttribute[]

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@map("attribute_value")
}

// Singleton row holding platform-wide format defaults (§9).
model PlatformSettings {
  id                String            @id @default(uuid()) @db.Uuid
  measurementSystem MeasurementSystem @default(metric) @map("measurement_system")
  dateFormat        DateFormat        @default(ddmmyyyy) @map("date_format")
  // Admin-defined standard column set for the Sales Transactions list (JSON array of keys).
  salesTxStandardColumns String? @map("sales_tx_standard_columns")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ===========================================================================
// Module 3 — Products: master record, aliases, media, attribute assignments,
// and the co-ownership link to companies (product_company, named in M1 §3).
// Money is stored as amount (Decimal) + currency_code (default EUR).
// Volumetric weight is NOT stored — it's derived on read from dimensions.
// ===========================================================================

model Product {
  id    String @id @default(uuid()) @db.Uuid
  mainSku String @unique @map("main_sku")
  title String

  brandId          String? @map("brand_id") @db.Uuid
  vendorId         String? @map("vendor_id") @db.Uuid
  productTypeId    String? @map("product_type_id") @db.Uuid
  fulfilmentTypeId String? @map("fulfilment_type_id") @db.Uuid
  categoryId       String? @map("category_id") @db.Uuid

  // Identifiers & origin
  ean             String?
  upc             String?
  vendorSku       String? @map("vendor_sku")
  manufacturerSku String? @map("manufacturer_sku")
  countryOfOrigin String? @map("country_of_origin")
  hsCode          String? @map("hs_code")

  // Cost & pricing (amount + currency)
  purchaseCostAmount   Decimal? @map("purchase_cost_amount") @db.Decimal(14, 4)
  purchaseCostCurrency String   @default("EUR") @map("purchase_cost_currency")
  mapAmount            Decimal? @map("map_amount") @db.Decimal(14, 4)
  mapCurrency          String   @default("EUR") @map("map_currency")
  msrpAmount           Decimal? @map("msrp_amount") @db.Decimal(14, 4)
  msrpCurrency         String   @default("EUR") @map("msrp_currency")

  // Package & logistics (metric base units: kg, cm)
  productWeightKg Decimal? @map("product_weight_kg") @db.Decimal(10, 3)
  packageWeightKg Decimal? @map("package_weight_kg") @db.Decimal(10, 3)
  packageLengthCm Decimal? @map("package_length_cm") @db.Decimal(10, 2)
  packageWidthCm  Decimal? @map("package_width_cm") @db.Decimal(10, 2)
  packageHeightCm Decimal? @map("package_height_cm") @db.Decimal(10, 2)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  productType   ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  fulfilmentType FulfilmentType? @relation(fields: [fulfilmentTypeId], references: [id], onDelete: SetNull)
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  aliases              ProductSkuAlias[]
  media                ProductMedia[]
  attributes           ProductAttribute[]
  companies            ProductCompany[]
  salesTransactionItems SalesTransactionItem[]
  fbaShipmentItems     FbaShipmentItem[]

  @@map("product")
}

model ProductSkuAlias {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  skuValue         String  @unique @map("sku_value")
  label            String?
  fulfilmentTypeId String? @map("fulfilment_type_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  fulfilmentType FulfilmentType? @relation(fields: [fulfilmentTypeId], references: [id], onDelete: SetNull)

  @@map("product_sku_alias")
}

model ProductMedia {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

// The real product↔attribute assignment (distinct from the M2 `attribute` library).
model ProductAttribute {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @map("product_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@map("product_attribute")
}

model ProductCompany {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId])
  @@map("product_company")
}

// ===========================================================================
// Global Data: Countries, Shipping Services, Sales Channels.
// Currencies are handled as ISO 4217 3-letter codes (stored as strings; a static
// list backs the dropdowns) — no table needed.
// ===========================================================================

model Country {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String   // ISO official name
  isoCode                  String   @unique @map("iso_code") // 2-char alpha-2
  continent                String
  euVatZone                Boolean  @default(false) @map("eu_vat_zone")
  vatRate                  Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  defaultShippingServiceId String?  @map("default_shipping_service_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  defaultShippingService ShippingService?      @relation("CountryDefaultService", fields: [defaultShippingServiceId], references: [id], onDelete: SetNull)
  zoneMemberships        ShippingZoneCountry[]
  shippingZoneMappings   CountryShippingZone[]
  salesChannels          SalesChannel[]
  salesTransactions      SalesTransaction[]
  fbaShipments           FbaShipment[]

  @@map("country")
}

model ShippingService {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  alias      String?
  calcMethod String @map("calc_method") // 'actual_weight' | 'volumetric_weight'
  // Tracking URL template for this courier. A `{tracking}` placeholder is replaced with
  // the shipment's tracking number to build a status/track link (used across modules).
  trackingUrlTemplate String? @map("tracking_url_template")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  zones               ShippingZone[]
  defaultForCountries Country[]             @relation("CountryDefaultService")
  countryMappings     CountryShippingZone[]
  salesTransactions   SalesTransaction[]    @relation("TxShippingService")
  shipments           Shipment[]            @relation("ShipmentShippingService")
  fbaShipments        FbaShipment[]         @relation("FbaShipmentService")

  @@map("shipping_service")
}

model ShippingZone {
  id                String @id @default(uuid()) @db.Uuid
  shippingServiceId String @map("shipping_service_id") @db.Uuid
  name              String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  service         ShippingService       @relation(fields: [shippingServiceId], references: [id], onDelete: Cascade)
  countries       ShippingZoneCountry[]
  rates           ShippingRate[]
  countryMappings CountryShippingZone[]
  fbaShipments    FbaShipment[]

  @@map("shipping_zone")
}

model ShippingZoneCountry {
  id        String @id @default(uuid()) @db.Uuid
  zoneId    String @map("zone_id") @db.Uuid
  countryId String @map("country_id") @db.Uuid

  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  country Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([zoneId, countryId])
  @@map("shipping_zone_country")
}

model ShippingRate {
  id           String  @id @default(uuid()) @db.Uuid
  zoneId       String  @map("zone_id") @db.Uuid
  fromWeightKg Decimal @map("from_weight_kg") @db.Decimal(10, 3)
  toWeightKg   Decimal @map("to_weight_kg") @db.Decimal(10, 3)
  chargeEur    Decimal @map("charge_eur") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rate")
}

// Which zone of a shipping service applies to a country (the Countries custom columns).
model CountryShippingZone {
  id                String @id @default(uuid()) @db.Uuid
  countryId         String @map("country_id") @db.Uuid
  shippingServiceId String @map("shipping_service_id") @db.Uuid
  zoneId            String @map("zone_id") @db.Uuid

  country Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  service ShippingService @relation(fields: [shippingServiceId], references: [id], onDelete: Cascade)
  zone    ShippingZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([countryId, shippingServiceId])
  @@map("country_shipping_zone")
}

model SalesChannel {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  nativeCountryId String? @map("native_country_id") @db.Uuid
  nativeCurrency     String? @map("native_currency") // ISO 4217 3-letter
  generalSalesFeePct Float?  @map("general_sales_fee_pct") // % fee charged per sale
  // Whether the sales fees are charged in the channel's native currency; if not,
  // feeCurrency holds the explicit currency the fees are charged in.
  feeChargedInNativeCurrency Boolean @default(true) @map("fee_charged_in_native_currency")
  feeCurrency                String? @map("fee_currency")
  // Marketplace-collected VAT threshold rule (e.g. UK £135): below/equal the threshold the
  // channel collects VAT at belowPct; above it VAT is import VAT (abovePct, usually 0).
  vatThresholdEnabled  Boolean @default(false) @map("vat_threshold_enabled")
  vatThresholdAmount   Float?  @map("vat_threshold_amount")
  vatThresholdCurrency String? @map("vat_threshold_currency")
  vatBelowThresholdPct Float?  @map("vat_below_threshold_pct")
  vatAboveThresholdPct Float?  @map("vat_above_threshold_pct")
  email              String?
  website            String?
  contactName        String? @map("contact_name")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  nativeCountry     Country?           @relation(fields: [nativeCountryId], references: [id], onDelete: SetNull)
  salesTransactions SalesTransaction[]
  fbaShipments      FbaShipment[]

  @@map("sales_channel")
}

// ===========================================================================
// Channel Integrations — direct API connections to sales channels (OnBuy first).
// Non-secret config lives on the integration; API keys/secrets are AES-256-GCM
// encrypted in integration_secret and NEVER returned through the API.
// ===========================================================================
model ChannelIntegration {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  channelType    String    @map("channel_type") // connector/family key: 'amazon' | 'ebay' | 'onbuy'
  marketplace    String?   @map("marketplace") // sub-channel id, e.g. 'UK', 'DE'
  config         Json      @default("{}") // non-secret fields (url, sellerId, siteIds, …)
  status         String    @default("active") // active | disabled
  lastTestedAt   DateTime? @map("last_tested_at")
  lastTestStatus String?   @map("last_test_status") // ok | fail
  lastTestMessage String?  @map("last_test_message")
  // Set when the user has reviewed & confirmed the field mapping (gate for import).
  mappingVerifiedAt DateTime? @map("mapping_verified_at")
  // Import settings: where imported orders land, and how the sync runs.
  targetSalesChannelId String?  @map("target_sales_channel_id") @db.Uuid
  targetCompanyId      String?  @map("target_company_id") @db.Uuid
  autoSyncEnabled      Boolean  @default(false) @map("auto_sync_enabled")
  backfillDays         Int      @default(30) @map("backfill_days")
  lastSyncedAt         DateTime? @map("last_synced_at") // high-water mark (max imported order date)
  lastSyncRunAt        DateTime? @map("last_sync_run_at")
  lastSyncStatus       String?   @map("last_sync_status") // ok | error
  lastSyncMessage      String?   @map("last_sync_message")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  secrets IntegrationSecret[]
  audits  IntegrationAudit[]

  @@map("channel_integration")
}

// One encrypted secret field (e.g. liveSecretKey). Stores only ciphertext + the
// GCM nonce/tag + key version + last-4 (for masked display). No plaintext, ever.
model IntegrationSecret {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  fieldKey      String   @map("field_key")
  ciphertext    String
  iv            String
  authTag       String   @map("auth_tag")
  keyVersion    Int      @map("key_version")
  last4         String
  updatedAt     DateTime @updatedAt @map("updated_at")

  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, fieldKey])
  @@map("integration_secret")
}

// Audit trail for integrations — who did what, when. Never records secret values.
model IntegrationAudit {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String?  @map("integration_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String // create | update | secret.set | secret.replace | delete | test
  detail        String?
  createdAt     DateTime @default(now()) @map("created_at")

  integration ChannelIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@map("integration_audit")
}

// Profit-percentage tiers: colour bands for the Profit (%) chip in the sales
// transaction list (e.g. Tier 1: 1–10% → green chip). Managed in Global Settings.
model ProfitTier {
  id        String @id @default(uuid()) @db.Uuid
  name      String?
  fromPct   Float  @map("from_pct")
  toPct     Float  @map("to_pct")
  bgColor   String @map("bg_color") // CSS colour for the chip background
  fontColor String @map("font_color") // CSS colour for the chip text
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profit_tier")
}

// Official Cyprus Customs monthly exchange rates (units of the foreign currency
// per 1 EUR), pulled from the Cyprus open-data portal (data.gov.cy) for tax use.
model CustomsExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  year         Int
  month        Int // 1-12
  currencyCode String   @map("currency_code") // 3-letter code from the source header
  currencyName String?  @map("currency_name")
  rate         Float // foreign currency units per 1 EUR
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([year, month, currencyCode])
  @@index([year, month])
  @@map("customs_exchange_rate")
}

// Audit log of each pull from the Cyprus customs open-data portal.
model CustomsFxSync {
  id             String    @id @default(uuid()) @db.Uuid
  status         String // 'success' | 'error'
  message        String?
  sourceUrl      String?   @map("source_url")
  sourceModified DateTime? @map("source_modified")
  monthsImported Int       @default(0) @map("months_imported")
  ratesImported  Int       @default(0) @map("rates_imported")
  trigger        String    @default("manual") // 'manual' | 'schedule' | 'startup'
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("customs_fx_sync")
}

// ===========================================================================
// Sales Transactions module — registers sales across all sales channels.
// Header + line items (one per SKU). Amounts stored in the sales channel's
// native currency, except the sales fee which uses the channel's fee currency
// (both snapshotted on the header at registration time).
// ===========================================================================

model SalesTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  date                 DateTime
  transactionRef       String   @map("transaction_ref") // the user's "Transaction ID"
  salesChannelId       String?  @map("sales_channel_id") @db.Uuid
  destinationCountryId String?  @map("destination_country_id") @db.Uuid
  companyId            String?  @map("company_id") @db.Uuid
  currency             String? // native currency snapshot (net/vat/shipping amounts)
  feeCurrency          String?  @map("fee_currency") // fee currency snapshot
  // draft = editable by anyone; submitted = locked (admin edits freely, non-admins need
  // an unlock granted). unlockedForEdit re-opens a submitted transaction to non-admins.
  status          String  @default("draft") // draft | submitted
  unlockedForEdit Boolean @default(false) @map("unlocked_for_edit")
  // Chosen shipping service (defaults to the destination country's default; editable).
  shippingServiceId String? @map("shipping_service_id") @db.Uuid
  // Snapshot: channel currency -> EUR exchange rate at the transaction date.
  exchangeRate Float? @map("exchange_rate")
  // Snapshot: fee currency -> EUR rate (same as exchangeRate when fee is in native currency).
  feeExchangeRate Float? @map("fee_exchange_rate")
  // Destination VAT %: auto-derived (channel threshold rule or country rate) unless the
  // user overrides it (vatOverridden = true keeps the manual value on re-save).
  destinationVatPct Float?  @map("destination_vat_pct")
  vatOverridden     Boolean @default(false) @map("vat_overridden")
  // Fulfilment lifecycle (operations): pending until an outbound shipment is recorded
  // and the order is marked fully shipped. 'cancelled' is used by the returns layer.
  fulfilmentStatus String @default("pending") @map("fulfilment_status") // pending | shipped | cancelled
  // Order resolution (returns/cancellations/refunds). Adjusts revenue/COGS in the profit calc.
  resolution      String   @default("none") @map("resolution") // none | cancelled | returned | replaced
  refundAmount    Float?   @map("refund_amount") // our-revenue portion refunded (net+shipping, exc VAT), native currency
  restockItems    Boolean  @default(false) @map("restock_items") // returned goods resellable → reverse COGS
  feeRefunded     Boolean  @default(false) @map("fee_refunded") // channel refunded its selling fee
  resolutionNotes String?  @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at")
  // Provenance: 'manual' or an importer key like 'onbuy'; integrationId links the
  // source integration so a re-sync only ever touches its own imported records.
  source        String  @default("manual") @map("source")
  integrationId String? @map("integration_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  salesChannel       SalesChannel?    @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  destinationCountry Country?         @relation(fields: [destinationCountryId], references: [id], onDelete: SetNull)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shippingService    ShippingService? @relation("TxShippingService", fields: [shippingServiceId], references: [id], onDelete: SetNull)
  items              SalesTransactionItem[]
  unlockRequests     SalesTransactionUnlockRequest[]
  shipments          Shipment[]

  @@map("sales_transaction")
}

// A physical shipment for a sales transaction (operations records actuals here).
// Outbound = to the customer; inbound = a return/receipt. The actual outbound
// shipping cost overrides the transaction's calculated estimate; duty and any
// company-borne return shipping are added as extra costs in the profit calc.
model Shipment {
  id                String   @id @default(uuid()) @db.Uuid
  transactionId     String   @map("transaction_id") @db.Uuid
  type              String   @default("outbound") // outbound | inbound
  shipmentDate      DateTime @map("shipment_date")
  shippingServiceId String?  @map("shipping_service_id") @db.Uuid
  trackingNumber    String?  @map("tracking_number")
  shippingCostEur   Float?   @map("shipping_cost_eur") // actual shipping cost, exc VAT, in EUR
  costBorneBy       String   @default("company") @map("cost_borne_by") // company | customer
  dutyImportEur     Float?   @map("duty_import_eur") // duty / import charges, in EUR
  comments          String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  transaction     SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  shippingService ShippingService? @relation("ShipmentShippingService", fields: [shippingServiceId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("shipment")
}

model SalesTransactionUnlockRequest {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @map("transaction_id") @db.Uuid
  requestedById String?   @map("requested_by") @db.Uuid
  status        String    @default("pending") // pending | granted | denied
  decidedById   String?   @map("decided_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("sales_transaction_unlock_request")
}

model SalesTransactionItem {
  id            String @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  sku           String
  quantity      Int    @default(1)

  netSalesAmount             Float? @map("net_sales_amount")
  vatAmount                  Float? @map("vat_amount")
  shippingAmount             Float? @map("shipping_amount")
  shippingAmountVat          Float? @map("shipping_amount_vat")
  salesChannelSalesFeeAmount Float? @map("sales_channel_sales_fee_amount")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sales_transaction_item")
}

// ===========================================================================
// FBA Shipments — shipments of our stock TO Amazon Fulfilment Centers.
// Used to estimate (and later record the actual) inbound shipping cost and to
// derive each SKU's average allocated inbound cost per sales channel, which
// feeds the profit calc for FBA orders.
// ===========================================================================
model FbaShipment {
  id                   String  @id @default(uuid()) @db.Uuid
  date                 DateTime
  salesChannelId       String? @map("sales_channel_id") @db.Uuid
  // Snapshot of the channel's native country at creation (the destination).
  destinationCountryId String? @map("destination_country_id") @db.Uuid
  // Unique FBA shipment identifier generated by the target sales channel (Amazon).
  fbaShipmentRef       String? @map("fba_shipment_ref")
  shippingServiceId    String? @map("shipping_service_id") @db.Uuid
  // Snapshot of the resolved zone + calc method at estimate time.
  shippingZoneId       String? @map("shipping_zone_id") @db.Uuid
  calcMethod           String? @map("calc_method") // 'actual_weight' | 'volumetric_weight'
  // Packaging uplift % added on top of summed product weight (actual-weight services).
  packagingPct         Decimal @default(10) @map("packaging_pct") @db.Decimal(6, 2)
  // Raw summed basis weight (before packaging) and the final weight used for the rate band.
  basisWeightKg        Decimal? @map("basis_weight_kg") @db.Decimal(12, 3)
  chargeableWeightKg   Decimal? @map("chargeable_weight_kg") @db.Decimal(12, 3)
  estimatedCostEur     Decimal? @map("estimated_cost_eur") @db.Decimal(12, 2)
  // Actual cost registered by operations; when set it overrides the estimate for allocation.
  actualCostEur        Decimal? @map("actual_cost_eur") @db.Decimal(12, 2)
  status               String  @default("draft") // draft | confirmed
  comments             String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  // Total empty-box weight (Σ box weights) snapshotted at estimate time.
  emptyBoxesWeightKg Decimal? @map("empty_boxes_weight_kg") @db.Decimal(12, 3)

  salesChannel       SalesChannel?    @relation(fields: [salesChannelId], references: [id], onDelete: SetNull)
  destinationCountry Country?         @relation(fields: [destinationCountryId], references: [id], onDelete: SetNull)
  shippingService    ShippingService? @relation("FbaShipmentService", fields: [shippingServiceId], references: [id], onDelete: SetNull)
  shippingZone       ShippingZone?    @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  boxes              FbaShipmentBox[]
  items              FbaShipmentItem[]

  @@index([salesChannelId])
  @@map("fba_shipment")
}

// A physical box within an FBA shipment. Holds its own empty weight + dimensions
// (so the box weight/volume feeds the shipping-cost calc) and an optional tracking
// number added later by operations (boxes may share or have distinct tracking).
model FbaShipmentBox {
  id             String  @id @default(uuid()) @db.Uuid
  shipmentId     String  @map("shipment_id") @db.Uuid
  label          String? // e.g. "Box 1"
  emptyWeightKg  Decimal? @map("empty_weight_kg") @db.Decimal(12, 3)
  lengthCm       Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm        Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(10, 2)
  trackingNumber String? @map("tracking_number")
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  shipment FbaShipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  items    FbaShipmentItem[]

  @@index([shipmentId])
  @@map("fba_shipment_box")
}

model FbaShipmentItem {
  id         String  @id @default(uuid()) @db.Uuid
  shipmentId String  @map("shipment_id") @db.Uuid
  boxId      String? @map("box_id") @db.Uuid
  productId  String? @map("product_id") @db.Uuid
  sku        String
  title      String? // snapshot of the product title at add time
  quantity   Int     @default(1)
  // Per-unit basis weight used for allocation (actual or volumetric per the service).
  unitWeightKg         Decimal? @map("unit_weight_kg") @db.Decimal(12, 3)
  // Shipping cost allocated to this line (effective cost × its weight×qty share).
  allocatedCostEur     Decimal? @map("allocated_cost_eur") @db.Decimal(12, 4)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  shipment FbaShipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  box      FbaShipmentBox? @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([boxId])
  @@index([productId])
  @@map("fba_shipment_item")
}
