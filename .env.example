# ---------------------------------------------------------------------------
# maSquare — local environment. Copy to .env and run; zero edits required.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database (matches docker-compose postgres service)
DATABASE_URL="postgresql://masquare:masquare@localhost:5434/masquare?schema=public"

# Auth
JWT_SECRET="dev-secret-change-me-this-is-not-for-production-use-only"
JWT_EXPIRES_IN="8h"

# Seeded admin (printed by the seed script on first run)
ADMIN_EMAIL="admin@masquare.local"
ADMIN_PASSWORD="masquare-admin"

# API
# 3200, not 3000: that is the default for Next.js and most JS dev servers, so it collides
# whenever another project is open alongside this one. Not 3100 either — the demo
# workspace (.env.demo) uses that, and the two must be runnable side by side.
API_PORT=3200
# Where the Vite dev server proxies /api. Must follow API_PORT.
API_PROXY_TARGET=http://localhost:3200
CORS_ORIGINS="http://localhost:5173"

# Object storage — S3-compatible. MinIO locally, GCS/S3 in prod (same SDK).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="masquare"
STORAGE_SECRET_KEY="masquare123"
STORAGE_BUCKET="masquare-media"
STORAGE_FORCE_PATH_STYLE="true"

# Amazon repricing — SP-API notification SQS poller. Leave UNSET in dev/local: the poller
# stays dormant unless all four are present. Set in production with the read-only IAM key.
AMZ_SQS_QUEUE_URL=""
AMZ_SQS_REGION=""
AMZ_SQS_ACCESS_KEY_ID=""
AMZ_SQS_SECRET_ACCESS_KEY=""

# Amazon repricing — price-writer master switches. Default OFF: even a LIVE SKU only gets a
# VALIDATION_PREVIEW dry-run until AMZ_REPRICING_LIVE_WRITES=true. The kill switch forces every
# write to SKIP regardless (global stop). Flip these only at the go-live gate.
AMZ_REPRICING_LIVE_WRITES="false"
AMZ_REPRICING_KILL_SWITCH="false"

# Web (Vite, build-time). Leave empty in dev — Vite proxies /api to the API.
VITE_API_BASE_URL=""

# Content gather — searching the web for product specifications, via Claude.
#
# Without a key the gather still runs: it reads the pages nominated on a product and asks Amazon,
# and simply reports that web search is switched off. With one, it also searches for pages nobody
# has nominated, which is the only way the authoritative source gets found automatically.
#
# BILLED PER USE. Roughly $0.17 per product on Sonnet 5 — token cost plus $10 per 1,000 searches.
# It runs on demand, once per product, never on a schedule.
ANTHROPIC_API_KEY=""
# Override only to trade cost against thoroughness: claude-haiku-4-5 is cheaper, claude-opus-5
# better on awkward pages. Defaults to claude-sonnet-5.
GATHER_MODEL=""

# maSquare connector — lets Claude (run by a person on their own Claude plan) research products and
# hand the evidence back. POST /api/mcp. OFF unless both values below are set.
#
# MCP_TOKEN: a long random secret, at least 32 characters. Anyone holding it can act as the user
# below, so treat it like a password: never commit it, never paste it into a chat.
# MCP_USER_EMAIL: the active maSquare user the connector acts as. That user's own company grants
# decide what the connector can reach, and suspending the user switches the connector off.
MCP_TOKEN=""
MCP_USER_EMAIL=""

# eBay UK pricing assumptions, used to suggest a price and to show what one earns.
# Defaults are eBay's published UK rates; set these when they change rather than editing code.
# EBAY_VAT_RATE: 0.2 for 20%.  EBAY_FEE_PCT: final value fee as a fraction of the buyer's total.
# EBAY_FIXED_FEE_PENCE: the per-order fixed fee, in pence.
EBAY_VAT_RATE=""
EBAY_FEE_PCT=""
EBAY_FIXED_FEE_PENCE=""
