# ---------------------------------------------------------------------------
# maSquare — local environment. Copy to .env and run; zero edits required.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database (matches docker-compose postgres service)
DATABASE_URL="postgresql://masquare:masquare@localhost:5434/masquare?schema=public"

# Auth
JWT_SECRET="dev-secret-change-me-this-is-not-for-production-use-only"
JWT_EXPIRES_IN="8h"

# Seeded admin (printed by the seed script on first run)
ADMIN_EMAIL="admin@masquare.local"
ADMIN_PASSWORD="masquare-admin"

# API
API_PORT=3000
CORS_ORIGINS="http://localhost:5173"

# Object storage — S3-compatible. MinIO locally, GCS/S3 in prod (same SDK).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="masquare"
STORAGE_SECRET_KEY="masquare123"
STORAGE_BUCKET="masquare-media"
STORAGE_FORCE_PATH_STYLE="true"

# Amazon repricing — SP-API notification SQS poller. Leave UNSET in dev/local: the poller
# stays dormant unless all four are present. Set in production with the read-only IAM key.
AMZ_SQS_QUEUE_URL=""
AMZ_SQS_REGION=""
AMZ_SQS_ACCESS_KEY_ID=""
AMZ_SQS_SECRET_ACCESS_KEY=""

# Amazon repricing — price-writer master switches. Default OFF: even a LIVE SKU only gets a
# VALIDATION_PREVIEW dry-run until AMZ_REPRICING_LIVE_WRITES=true. The kill switch forces every
# write to SKIP regardless (global stop). Flip these only at the go-live gate.
AMZ_REPRICING_LIVE_WRITES="false"
AMZ_REPRICING_KILL_SWITCH="false"

# Web (Vite, build-time). Leave empty in dev — Vite proxies /api to the API.
VITE_API_BASE_URL=""
