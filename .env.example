# ---------------------------------------------------------------------------
# maSquare — local environment. Copy to .env and run; zero edits required.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database (matches docker-compose postgres service)
DATABASE_URL="postgresql://masquare:masquare@localhost:5434/masquare?schema=public"

# Auth
JWT_SECRET="dev-secret-change-me-this-is-not-for-production-use-only"
JWT_EXPIRES_IN="8h"

# Seeded admin (printed by the seed script on first run)
ADMIN_EMAIL="admin@masquare.local"
ADMIN_PASSWORD="masquare-admin"

# API
API_PORT=3000
CORS_ORIGINS="http://localhost:5173"

# Object storage — S3-compatible. MinIO locally, GCS/S3 in prod (same SDK).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="masquare"
STORAGE_SECRET_KEY="masquare123"
STORAGE_BUCKET="masquare-media"
STORAGE_FORCE_PATH_STYLE="true"

# Web (Vite, build-time). Leave empty in dev — Vite proxies /api to the API.
VITE_API_BASE_URL=""
